# Generated by tools/build_one_trait_panel.py -- edit the tables there, not this file.
# One Trait 2.5: the One Trait panel and its button. No vanilla file is replaced: both are registered in
# gui/scripted_widgets/one_trait_panel_widgets.txt. Patterns proven in Pantheon of One 2.0 and the 2.5 Task 0.

# The button beside Pantheon's (which sits at { 20 -360 }). The outer widget waits for a valid player; the
# inner button holds the scripted-GUI check (a check with no player errors every frame).
widget = {
	name = "one_trait_panel_button"
	visible = "[And( GetPlayer.IsValid, And( And( Not( IsPauseMenuShown ), Not( IsObserver ) ), IsDefaultGUIMode ) )]"
	parentanchor = bottom|left
	position = { 70 -360 }
	size = { 44 44 }
	layer = hud_layer

	button_round = {
		size = { 44 44 }
		visible = "[GetScriptedGui('one_trait_ui_is_player').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		onclick = "[GetScriptedGui('one_trait_ui_toggle').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		tooltip = "one_trait_panel_button_tt"
		icon = {
			parentanchor = center
			alwaystransparent = yes
			size = { 30 30 }
			texture = "gfx/interface/icons/character_interactions/one_trait_menu_interaction.dds"
			modify_texture = {
				texture = "gfx/interface/component_masks/mask_circle.dds"
				blend_mode = alphamultiply
			}
		}
	}
}

window = {
	name = "one_trait_panel_window"
	position = { 0 20 }
	parentanchor = center
	layer = middle
	size = { 1000 900 }
	visible = "[And( GetPlayer.IsValid, GetPlayer.MakeScope.Var('one_trait_ui_open').IsSet )]"

	using = Window_Background
	using = Window_Decoration

	vbox = {
		using = Window_Margins
		spacing = 10
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		header_pattern = {
			layoutpolicy_horizontal = expanding
			size = { 0 50 }
			blockoverride "header_text" {
				text = "one_trait_panel_title"
			}
			blockoverride "button_close" {
				onclick = "[GetScriptedGui('one_trait_ui_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}

		# Who the Traits, Sanctum and Army tabs act on
		hbox = {
			visible = "[GetPlayer.MakeScope.Var('one_trait_ui_target').IsSet]"
			layoutpolicy_horizontal = expanding
			hbox = {
			datacontext = "[GetPlayer.MakeScope.Var('one_trait_ui_target').GetCharacter]"
			layoutpolicy_horizontal = expanding
			spacing = 10
			portrait_head_small = {}
			text_single = {
				text = "[Character.GetFullNameNoTooltip]"
				using = Font_Size_Medium
			}
			# Character.IsLocalPlayer: game/gui/hud.gui:3432.
			text_single = {
				visible = "[Character.IsLocalPlayer]"
				text = "one_trait_panel_you"
				using = Font_Size_Medium
			}
			expand = {}
			button_standard = {
				size = { 120 32 }
				text = "one_trait_panel_yourself"
				onclick = "[GetScriptedGui('one_trait_ui_yourself').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			}
		}

		# ---- Sidebar (left) + content (right), one hbox (spec section 1) ----
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 12

			# ---- Sidebar (left): one button per category, top-aligned (Proven, Task 0: the prototype
			# centred it; layoutpolicy_vertical = expanding + a trailing expand = {} keeps it at the top,
			# the same way this file's own Army tab already top-aligns fixed-size content, and as proven in
			# vanilla at game/gui/window_my_realm.gui:447-615). ----
			vbox = {
				layoutpolicy_vertical = expanding
				margin = { 8 8 }
				spacing = 4
				background = { using = Background_Area_Dark }
				button_standard = {
					size = { 170 40 }
					text = "one_trait_panel_cat_character"
					down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('one_trait_ui_tab').GetValue, '(CFixedPoint)1' )]"
					onclick = "[GetScriptedGui('one_trait_ui_tab_character').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
				button_standard = {
					size = { 170 40 }
					text = "one_trait_panel_cat_traits"
					down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('one_trait_ui_tab').GetValue, '(CFixedPoint)2' )]"
					onclick = "[GetScriptedGui('one_trait_ui_tab_traits').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
				button_standard = {
					size = { 170 40 }
					text = "one_trait_panel_cat_realm"
					down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('one_trait_ui_tab').GetValue, '(CFixedPoint)3' )]"
					onclick = "[GetScriptedGui('one_trait_ui_tab_realm').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					enabled = "[GetScriptedGui('one_trait_ui_target_is_ruler').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "one_trait_panel_realm_locked"
					tooltip_visible = "[Not( GetScriptedGui('one_trait_ui_target_is_ruler').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				}
				button_standard = {
					size = { 170 40 }
					text = "one_trait_panel_cat_sanctum"
					down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('one_trait_ui_tab').GetValue, '(CFixedPoint)4' )]"
					onclick = "[GetScriptedGui('one_trait_ui_tab_sanctum').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
