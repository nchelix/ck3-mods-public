													expand = {}
													# 2.3 B4/R9: outside sending mode Lend and Wed open the vanilla interaction window for the follower
													# selected in the Followers tab with this demigod preselected; while sending, Send replaces them.
													button_standard = {
														size = { 56 28 }
														visible = "[Not( GetPlayer.MakeScope.Var('pantheon_send_kind').IsSet )]"
														text = "pantheon_ui_btn_lend"
														enabled = "[GetScriptedGui('pantheon_ui_row_lend').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_demigod', Character.MakeScope ).End )]"
														tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_row_lend').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_demigod', Character.MakeScope ).End ), Localize( 'pantheon_ui_row_lend_tt' ), GetScriptedGui('pantheon_ui_row_lend').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_demigod', Character.MakeScope ).End ) )]"
														onclick = "[GetScriptedGui('pantheon_ui_row_lend').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_demigod', Character.MakeScope ).End )]"
													}
													button_standard = {
														size = { 56 28 }
														visible = "[Not( GetPlayer.MakeScope.Var('pantheon_send_kind').IsSet )]"
														text = "pantheon_ui_btn_wed"
														enabled = "[GetScriptedGui('pantheon_ui_row_wed').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_demigod', Character.MakeScope ).End )]"
														tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_row_wed').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_demigod', Character.MakeScope ).End ), Localize( 'pantheon_ui_row_wed_tt' ), GetScriptedGui('pantheon_ui_row_wed').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_demigod', Character.MakeScope ).End ) )]"
														onclick = "[GetScriptedGui('pantheon_ui_row_wed').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_demigod', Character.MakeScope ).End )]"
													}
													button_standard = {
														size = { 120 28 }
														visible = "[GetPlayer.MakeScope.Var('pantheon_send_kind').IsSet]"
														text = "pantheon_ui_btn_send_demigod"
														enabled = "[GetScriptedGui('pantheon_ui_send_demigod').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_send_demigod', Character.MakeScope ).End )]"
														tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_send_demigod').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_send_demigod', Character.MakeScope ).End ), Select_CString( EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_send_kind').GetValue, '(CFixedPoint)2' ), Localize( 'pantheon_ui_send_wed_tt' ), Localize( 'pantheon_ui_send_lend_tt' ) ), GetScriptedGui('pantheon_ui_send_demigod').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_send_demigod', Character.MakeScope ).End ) )]"
														onclick = "[GetScriptedGui('pantheon_ui_send_demigod').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_send_demigod', Character.MakeScope ).End )]"
													}
													button_standard = {
														size = { 110 28 }
														text = "pantheon_ui_btn_call_home"
														visible = "[And( Not( GetPlayer.MakeScope.Var('pantheon_send_kind').IsSet ), Character.IsPlayerInteractionShown('pantheon_call_home_interaction') )]"
														tooltip = "[Character.GetPlayerInteractionTooltip('pantheon_call_home_interaction')]"
														onclick = "[Character.OpenPlayerInteraction('pantheon_call_home_interaction')]"
													}
													# 2.4: Free a demigod held by someone else (shown only while they are in a cell)
													button_standard = {
														size = { 110 28 }
														text = "pantheon_ui_btn_free_demigod"
														visible = "[And( Not( GetPlayer.MakeScope.Var('pantheon_send_kind').IsSet ), Character.IsPlayerInteractionShown('pantheon_free_demigod_interaction') )]"
														enabled = "[Character.IsPlayerInteractionValid('pantheon_free_demigod_interaction')]"
														tooltip = "[Character.GetPlayerInteractionTooltip('pantheon_free_demigod_interaction')]"
														onclick = "[Character.OpenPlayerInteraction('pantheon_free_demigod_interaction')]"
													}
													# 2.4: Dissolve a wed demigod's marriage (shown only while they are wed and married)
													button_standard = {
														size = { 110 28 }
														text = "pantheon_ui_btn_dissolve"
														visible = "[And( Not( GetPlayer.MakeScope.Var('pantheon_send_kind').IsSet ), Character.IsPlayerInteractionShown('pantheon_dissolve_interaction') )]"
														enabled = "[Character.IsPlayerInteractionValid('pantheon_dissolve_interaction')]"
														tooltip = "[Character.GetPlayerInteractionTooltip('pantheon_dissolve_interaction')]"
														onclick = "[Character.OpenPlayerInteraction('pantheon_dissolve_interaction')]"
													}
												}
											}
										}
									}
								}
							}
						}
					}

					text_single = { text = "pantheon_ui_houses_header" using = Font_Size_Medium }
					scrollbox = {
						layoutpolicy_horizontal = expanding
						size = { 0 220 }
						blockoverride "scrollbox_empty" {
							text = "pantheon_ui_no_houses"
							visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList('pantheon_ui_houses') )]"
						}
						blockoverride "scrollbox_content" {
							fixedgridbox = {
								datamodel = "[GetPlayer.MakeScope.GetList('pantheon_ui_houses')]"
								addcolumn = 680
								addrow = 70
								setitemsizefromcell = yes
								item = {
									widget = {
										datacontext = "[Scope.GetCharacter]"
										size = { 676 66 }
										hbox = {
											spacing = 8
											margin_left = 6
											margin_right = 10
											background = { using = Background_Area_With_Header }
											portrait_head_small = {}
											text_single = {
												layoutpolicy_horizontal = expanding
												autoresize = no
												text = "pantheon_ui_house_line"
											}
											text_single = {
												visible = "[GreaterThan_CFixedPoint( Character.MakeScope.ScriptValue('pantheon_ui_house_revealed'), '(CFixedPoint)0' )]"
												text = "pantheon_ui_house_revealed"
											}
											button_standard = {
												size = { 110 30 }
												text = "pantheon_ui_btn_reveal"
												visible = "[Character.IsPlayerInteractionShown('pantheon_reveal_interaction')]"
												tooltip = "[Character.GetPlayerInteractionTooltip('pantheon_reveal_interaction')]"
												onclick = "[Character.OpenPlayerInteraction('pantheon_reveal_interaction')]"
											}
										}
									}
								}
							}
						}
					}
				}

				# ---- Tab 3: The God
				vbox = {
					visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_tab').GetValue, '(CFixedPoint)3' )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 8
					# 2.11 (Task 12): the God tab's sub-tabs, as the Followers tab's. pantheon_ui_gtab: 1 Overview (also when absent),
					# 2 Seeded lands, its count beside the label. The Worship line above every tab is the only Worship line now; the
					# Godhood tour button is gone (vanilla's Activities list hosts the tour), and the oath, Great Prayer cooldown,
					# plague and temple lines give way to the Overview's cards.
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 0

						button_tab = {
							onclick = "[GetScriptedGui('pantheon_ui_gtab_1').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[Or( Not( GetPlayer.MakeScope.Var('pantheon_ui_gtab').IsSet ), EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_gtab').GetValue, '(CFixedPoint)1' ) )]"
							blockoverride "tab_label" {
								text = "pantheon_ui_gtab_overview"
							}
						}
						button_tab = {
							onclick = "[GetScriptedGui('pantheon_ui_gtab_2').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[And( GetPlayer.MakeScope.Var('pantheon_ui_gtab').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_gtab').GetValue, '(CFixedPoint)2' ) )]"
							blockoverride "tab_label" {
								text = "pantheon_ui_gtab_seeds"
							}
							blockoverride "extra_info" {
								text_single = {
									text = "[GetDataModelSize( GetPlayer.MakeScope.GetList('pantheon_ui_seeds') )]"
									align = nobaseline
									default_format = "#low"
									margin_top = 3
								}
							}
						}
					}

					# ---- Sub-tab 1: Overview
					vbox = {
						visible = "[Or( Not( GetPlayer.MakeScope.Var('pantheon_ui_gtab').IsSet ), EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_gtab').GetValue, '(CFixedPoint)1' ) )]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 8

						# P2d (Codex Phase 2 review): the whole Overview (action strip and cards: 470 high since P2e) scrolls in the height the
						# window leaves it. The selected-follower strip above every tab varies, 38 with nobody selected to 348 and more
						# with every blessing, so no one fixed height fits: the box expands into what is left (900 - 137 outer - strip -
						# 50 sub-tabs; 675 with no strip, everything shows; 365 under a tall one, it scrolls), as the Followers, Prayers
						# and Quiet lists do (the Quiet tab's fixed 270 cut off early in game). The margins are 0 left and 16 right, room
						# for vanilla's 12-wide scrollbar, so the 706 the cards take fits the 722 column exactly (vanilla's 15 / 20
						# would leave 687). The cards draw their own backgrounds, so the box draws none. The content below keeps its
						# old indentation, so the diff stays small.
						scrollbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							blockoverride "scrollbox_background" {}
							blockoverride "scrollbox_margins" {
								margin_right = 16
							}
							blockoverride "scrollbox_content" {
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 8

						# The action strip "Your divinity:". Each action shows only when usable, as before. The column is 722 wide, so
						# the label takes its own row and the buttons (200 wide for the longer labels) sit below it. Forswear and
						# Embrace are exclusive, so at most three buttons show (3 x 200 + 2 x 6 = 612); ignoreinvisible keeps a
						# hidden one from leaving a gap.
						vbox = {
							layoutpolicy_horizontal = expanding
							margin = { 8 6 }
							spacing = 4
							background = { using = Background_Area }

							text_single = {
								size = { 690 22 }
								autoresize = no
								align = left|nobaseline
								text = "pantheon_ui_god_actions"
								default_format = "#low"
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 6
								ignoreinvisible = yes
								button_standard = {
									size = { 200 32 }
									text = "pantheon_ui_btn_throne"
									tooltip = "pantheon_tip.0001.throne.tt"
									visible = "[GetScriptedGui('pantheon_ui_throne').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									onclick = "[GetScriptedGui('pantheon_ui_throne').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								}
								button_standard = {
									size = { 200 32 }
									text = "pantheon_ui_btn_proclaim"
									tooltip = "pantheon_tip.0001.proclaim.tt"
									visible = "[GetScriptedGui('pantheon_ui_proclaim').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									onclick = "[GetScriptedGui('pantheon_ui_proclaim').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								}
								button_standard = {
									size = { 200 32 }
									text = "pantheon_ui_btn_forswear"
									tooltip = "pantheon_tip.0001.forswear.tt"
									visible = "[GetScriptedGui('pantheon_ui_forswear').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									onclick = "[GetScriptedGui('pantheon_ui_forswear').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								}
								button_standard = {
									size = { 200 32 }
									text = "pantheon_ui_btn_embrace"
									tooltip = "pantheon_tip.0001.embrace.tt"
									visible = "[GetScriptedGui('pantheon_ui_embrace').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									onclick = "[GetScriptedGui('pantheon_ui_embrace').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								}
								expand = {}
							}
						}

						# 2.11 (Task 13): the Worship, Followers and Ready-when cards, then Your pantheon (P2e). The column is 722 wide (706 with
						# the 16 the strip keeps spare), so three ~300 cards do not fit side by side: Worship (250) and Followers (448)
						# share the top row, 250 + 8 + 448 = 706, and Ready when is full width below. Every card is a fixed-size widget
						# and every text a fixed size with autoresize = no, so a long translation clips instead of pushing the layout.
						vbox = {
							name = "pantheon_god_cards"
							layoutpolicy_horizontal = expanding
							spacing = 8

							hbox = {
								spacing = 8

								# ---- Worship: this season's income (already including the temple and Age of Faith factors), last
								# season's actual credit, and the factors in force
								widget = {
									name = "pantheon_card_worship"
									size = { 250 146 }
									background = { using = Background_Area }
									vbox = {
										margin = { 10 6 }
										spacing = 3
										text_single = {
											size = { 230 22 }
											autoresize = no
											align = left|nobaseline
											using = Font_Size_Medium
											text = "pantheon_ui_card_worship_t"
										}
										text_single = {
											size = { 230 20 }
											autoresize = no
											align = left|nobaseline
											text = "pantheon_ui_card_worship_season"
										}
										text_single = {
											visible = "[GetPlayer.MakeScope.Var('pantheon_last_worship').IsSet]"
											size = { 230 20 }
											autoresize = no
											align = left|nobaseline
											text = "pantheon_ui_card_worship_last"
										}
										text_single = {
											visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_temple_worship_factor'), '(CFixedPoint)1' )]"
											size = { 230 20 }
											autoresize = no
											align = left|nobaseline
											text = "pantheon_ui_card_worship_temple"
										}
										text_single = {
											visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_temple_age_factor'), '(CFixedPoint)1' )]"
											size = { 230 20 }
											autoresize = no
											align = left|nobaseline
											text = "pantheon_ui_card_worship_age"
										}
										# P2e: takes the spare height, so the lines shown sit under the title whichever are hidden
										# (a box larger than its children otherwise spreads the spare among them)
										expand = {}
									}
								}

								# ---- Followers: the whole follower set (pantheon_ui_follower_stats_effect counts it on every rebuild)
								widget = {
									name = "pantheon_card_followers"
									size = { 448 146 }
									background = { using = Background_Area }
									vbox = {
										margin = { 10 6 }
										spacing = 3
										text_single = {
											size = { 428 22 }
											autoresize = no
											align = left|nobaseline
											using = Font_Size_Medium
											text = "pantheon_ui_card_followers_t"
										}
										hbox = {
											spacing = 8
											text_single = {
												size = { 200 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_card_followers"
											}
											text_single = {
												size = { 220 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_card_devotion_avg"
											}
										}
										# The stacked Devotion bar: five vanilla progressbar_standard overlaid at one fixed size, the
										# cumulative shares of the measured from cum_5 (everyone) down to cum_1 (Zealous). Later
										# children draw on top, so each band shows as the strip between two bars: Zealous on the left,
										# Lapsing on the right. Only the bottom bar draws an empty track; the four above use blank.dds,
										# as vanilla's overlaid court-grandeur bars do (window_court_amenities.gui). Nobody measured:
										# cum_5 is 0 and the bar is an empty track. P2e: vanilla's progress_purple / _green / _blue / _red were too dark
										# on the card (a tint only darkens), so the bands use the brightest vanilla bars of each colour: Zealous
										# progress_brown (tan-gold), Devout progress_grandeur_increase, Faithful war_progress_blue, Wavering
										# progress_orange, Lapsing war_progress_red.
										widget = {
											name = "pantheon_band_bar"
											size = { 428 12 }
											progressbar_standard = {
												size = { 428 12 }
												min = 0
												max = 100
												value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('pantheon_ui_band_cum_5') )]"
												blockoverride "progress_textures" {
													progresstexture = "gfx/interface/progressbars/war_progress_red.dds"
													noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
												}
											}
											progressbar_standard = {
												size = { 428 12 }
												min = 0
												max = 100
												value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('pantheon_ui_band_cum_4') )]"
												blockoverride "progress_textures" {
													progresstexture = "gfx/interface/progressbars/progress_orange.dds"
													noprogresstexture = "gfx/interface/progressbars/blank.dds"
												}
											}
											progressbar_standard = {
												size = { 428 12 }
												min = 0
												max = 100
												value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('pantheon_ui_band_cum_3') )]"
												blockoverride "progress_textures" {
													progresstexture = "gfx/interface/progressbars/war_progress_blue.dds"
													noprogresstexture = "gfx/interface/progressbars/blank.dds"
												}
											}
											progressbar_standard = {
												size = { 428 12 }
												min = 0
												max = 100
												value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('pantheon_ui_band_cum_2') )]"
												blockoverride "progress_textures" {
													progresstexture = "gfx/interface/progressbars/progress_grandeur_increase.dds"
													noprogresstexture = "gfx/interface/progressbars/blank.dds"
												}
											}
											progressbar_standard = {
												size = { 428 12 }
												min = 0
												max = 100
												value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('pantheon_ui_band_cum_1') )]"
												blockoverride "progress_textures" {
													progresstexture = "gfx/interface/progressbars/progress_brown.dds"
													noprogresstexture = "gfx/interface/progressbars/blank.dds"
												}
											}
										}
										# The band counts, each beside a swatch of its band's colour (3 x 134 + 2 x 6 = 414; P2e: the swatches use the bars' textures)
										hbox = {
											spacing = 6
											hbox = {
												spacing = 4
												icon = {
													size = { 10 10 }
													texture = "gfx/interface/progressbars/progress_brown.dds"
												}
												text_single = {
													size = { 120 20 }
													autoresize = no
													align = left|nobaseline
													text = "pantheon_ui_card_band_zealous"
												}
											}
											hbox = {
												spacing = 4
												icon = {
													size = { 10 10 }
													texture = "gfx/interface/progressbars/progress_grandeur_increase.dds"
												}
												text_single = {
													size = { 120 20 }
													autoresize = no
													align = left|nobaseline
													text = "pantheon_ui_card_band_devout"
												}
											}
											hbox = {
												spacing = 4
												icon = {
													size = { 10 10 }
													texture = "gfx/interface/progressbars/war_progress_blue.dds"
												}
												text_single = {
													size = { 120 20 }
													autoresize = no
													align = left|nobaseline
													text = "pantheon_ui_card_band_faithful"
												}
											}
										}
										hbox = {
											spacing = 6
											hbox = {
												spacing = 4
												icon = {
													size = { 10 10 }
													texture = "gfx/interface/progressbars/progress_orange.dds"
												}
												text_single = {
													size = { 120 20 }
													autoresize = no
													align = left|nobaseline
													text = "pantheon_ui_card_band_wavering"
												}
											}
											hbox = {
												spacing = 4
												icon = {
													size = { 10 10 }
													texture = "gfx/interface/progressbars/war_progress_red.dds"
												}
												text_single = {
													size = { 120 20 }
													autoresize = no
													align = left|nobaseline
													text = "pantheon_ui_card_band_lapsing"
												}
											}
										}
										text_single = {
											visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_ui_follower_unmeasured'), '(CFixedPoint)0' )]"
											size = { 428 20 }
											autoresize = no
											align = left|nobaseline
											text = "pantheon_ui_card_unmeasured"
										}
										expand = {}
									}
								}
							}

							# ---- Ready when: one row per timer, a label, a fixed 300 x 20 box of alternative bars and a fixed 162 x 20 box of
							# alternative states (200 + 8 + 300 + 8 + 162 = 678 of the card's 686). A cooldown bar fills (elapsed = full -
							# remaining) and shows full and green with a green "Ready" when nothing is running (not the Plague's toll, which
							# is no cooldown: "None" over an empty track; Age of Faith drains). Timed variables read their
							# days left with VarRemaining (int32), only under a visible holding that variable's IsSet (Review Focus 5); the
							# months counters (miracle cooldown, Age of Faith) read script values whose full length follows the game rule.
							# A row whose feature is not there yet says "Needs ..." over an empty track: a miracle needs an active tier 5
							# temple (pantheon_miracle_ready_trigger), the smallest Sign of Steadfastness an active tier 1
							# (pantheon_ui_steady_arm_slipping).
							widget = {
								name = "pantheon_card_ready"
								size = { 706 150 }
								background = { using = Background_Area }
								vbox = {
									margin = { 10 6 }
									spacing = 3
									text_single = {
										size = { 686 22 }
										autoresize = no
										align = left|nobaseline
										using = Font_Size_Medium
										text = "pantheon_ui_card_ready_t"
									}

									# Great Prayer: pantheon_great_prayer_cooldown, years = 2 (730 days) wherever it is set
									hbox = {
