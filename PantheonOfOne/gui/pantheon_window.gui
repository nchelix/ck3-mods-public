												size = { 162 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_ready_none"
											}
										}
									}

									# Age of Faith: pantheon_temple_age_months, a months-left counter of pantheon_temple_age_years x 12. Not a
									# cooldown, so its bar drains: the months left.
									hbox = {
										name = "pantheon_ready_age"
										spacing = 8
