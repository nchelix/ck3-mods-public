														spacing = 6
														button_standard = {
															size = { 150 30 }
															visible = "[GetScriptedGui('pantheon_ui_retri_send').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_retri_attacker', Character.MakeScope ).End )]"
															text = "pantheon_ui_btn_retri_send"
															enabled = "[GetScriptedGui('pantheon_ui_retri_send').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_retri_attacker', Character.MakeScope ).End )]"
															tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_retri_send').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_retri_attacker', Character.MakeScope ).End ), Localize( 'pantheon_ui_retri_send_after_tt' ), GetScriptedGui('pantheon_ui_retri_send').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_retri_attacker', Character.MakeScope ).End ) )]"
															onclick = "[GetScriptedGui('pantheon_ui_retri_send').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_retri_attacker', Character.MakeScope ).End )]"
