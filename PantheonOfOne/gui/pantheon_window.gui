															}
															text_single = {
																visible = "[EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_aspiration_kind').GetValue, '(CFixedPoint)2' )]"
																layoutpolicy_horizontal = expanding
																autoresize = no
																text = "pantheon_ui_wants_2"
															}
															text_single = {
																visible = "[EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_aspiration_kind').GetValue, '(CFixedPoint)3' )]"
																layoutpolicy_horizontal = expanding
																autoresize = no
																text = "pantheon_ui_wants_3"
															}
															text_single = {
