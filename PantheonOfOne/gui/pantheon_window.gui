						# ---- 2.9 Task 5: A Sign of Steadfastness, the steadying act. 2.12 Task 4: a 706-wide card after the Miracles card, in its
						# style: a title row, then either the picker (nothing armed) or the armed panel, never both. LAYOUT: the title row is
						# 706 x 32: 10 + the 32 icon + 8 + the 260 name + 10 + the 376 corner (the rest while it runs, else "Ready") + 10 = 706.
						# The picker is 706 wide (8 + 688 + 8): a 190 column of the two 28 reach buttons (28 + 6 + 28 = 62, held at the top)
						# + 8 + the kingdom list, a PLAIN datamodel vbox of 490 x 28 rows (8 + 240 name + 8 + 110 count + 8 + 100 button + 8
						# = 482) that grows with its rows inside the page's one scrollbox (no scrollbox in a scrollbox, Review Focus 5). The
						# armed panel is a fixed 690 x 100: 10 + a 460 column (24 + 2 + 24 + 2 + 40 = 92 under a 4 top margin) + 10 + a 200
						# column of two 32 buttons + 10 = 690. Every text has a FIXED size and does not size itself (autoresize = no), the
						# full text in a tooltip where it may clip, so a long kingdom name or a long localized sentence can never push a row
						# wider or the panel taller. Each loc that reads a variable is guarded by that variable's IsSet in its own visible.
						vbox = {
							name = "pantheon_temple_sign"
							spacing = 8
							widget = {
								name = "pantheon_temple_sign_title_row"
								size = { 706 32 }
								background = { using = Background_Area }
								icon = {
									position = { 10 0 }
									size = { 32 32 }
									texture = "gfx/interface/icons/pantheon/pantheon_steady.dds"
								}
								text_single = {
									position = { 50 0 }
									size = { 260 32 }
									autoresize = no
									align = left|vcenter
									using = Font_Size_Medium
									text = "pantheon_ui_steady_header"
									tooltip = "pantheon_ui_steady_header_tt"
								}
								# the five-year rest while it runs, else Ready; the time only under its own IsSet
								widget = {
									name = "pantheon_temple_sign_corner"
									position = { 320 0 }
									size = { 376 32 }
									text_single = {
										visible = "[GetPlayer.MakeScope.Var('pantheon_steady_cooldown').IsSet]"
										size = { 376 32 }
										autoresize = no
										align = right|vcenter
										text = "pantheon_ui_steady_cooldown_line"
										tooltip = "pantheon_steady_cooldown_tt"
									}
									text_single = {
										visible = "[Not( GetPlayer.MakeScope.Var('pantheon_steady_cooldown').IsSet )]"
										size = { 376 32 }
										autoresize = no
										align = right|vcenter
										text = "pantheon_ui_steady_ready"
									}
								}
							}

							# nothing armed: the two reach buttons and the kingdom list
							hbox = {
								name = "pantheon_temple_sign_picker"
								visible = "[Not( GetPlayer.MakeScope.Var('pantheon_steady_reach').IsSet )]"
								minimumsize = { 706 0 }
								background = { using = Background_Area }
								margin = { 8 8 }
								spacing = 8
								vbox = {
									name = "pantheon_temple_sign_reach"
									# the buttons stay at the top while the list beside them grows
									layoutpolicy_vertical = expanding
									spacing = 6
									button_standard = {
										size = { 190 28 }
										text = "pantheon_ui_btn_steady_slipping"
										enabled = "[GetScriptedGui('pantheon_ui_steady_arm_slipping').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_steady_arm_slipping').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Localize( 'pantheon_ui_steady_slipping_tt' ), GetScriptedGui('pantheon_ui_steady_arm_slipping').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
										onclick = "[GetScriptedGui('pantheon_ui_steady_arm_slipping').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									}
									button_standard = {
										size = { 190 28 }
										text = "pantheon_ui_btn_steady_faith"
										enabled = "[GetScriptedGui('pantheon_ui_steady_arm_faith').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_steady_arm_faith').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Localize( 'pantheon_ui_steady_faith_tt' ), GetScriptedGui('pantheon_ui_steady_arm_faith').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
										onclick = "[GetScriptedGui('pantheon_ui_steady_arm_faith').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									}
									expand = {}
								}
								# the kingdoms that hold followers (most first): a plain list that grows with its rows inside the page
								vbox = {
									name = "pantheon_temple_sign_kingdoms"
									layoutpolicy_vertical = expanding
									spacing = 2
									text_single = {
										visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList('pantheon_ui_steady_kingdoms') )]"
										size = { 490 28 }
										autoresize = no
										align = left|vcenter
										text = "pantheon_ui_steady_kingdom_empty"
									}
									vbox = {
										datamodel = "[GetPlayer.MakeScope.GetList('pantheon_ui_steady_kingdoms')]"
										spacing = 2
										item = {
											widget = {
												name = "pantheon_temple_sign_row"
												size = { 490 28 }
												visible = "[Scope.GetLandedTitle.MakeScope.Var('pantheon_ui_steady_n').IsSet]"
												datacontext = "[Scope.GetLandedTitle]"
												background = { using = Background_Area }
												hbox = {
													margin_left = 8
													margin_right = 8
													spacing = 8
													text_single = {
														size = { 240 26 }
														autoresize = no
														align = left|vcenter
														text = "[Title.GetNameNoTooltip]"
														tooltip = "[Title.GetNameNoTooltip]"
													}
													# the count: "N followers", or "1 follower"; two texts overlapping in one fixed cell
													widget = {
														size = { 110 26 }
														text_single = {
															visible = "[And( Title.MakeScope.Var('pantheon_ui_steady_n').IsSet, Not( EqualTo_CFixedPoint( Title.MakeScope.Var('pantheon_ui_steady_n').GetValue, '(CFixedPoint)1' ) ) )]"
															size = { 110 26 }
															autoresize = no
															align = left|vcenter
															text = "pantheon_ui_steady_kingdom_n"
														}
														text_single = {
															visible = "[And( Title.MakeScope.Var('pantheon_ui_steady_n').IsSet, EqualTo_CFixedPoint( Title.MakeScope.Var('pantheon_ui_steady_n').GetValue, '(CFixedPoint)1' ) )]"
															size = { 110 26 }
															autoresize = no
															align = left|vcenter
															text = "pantheon_ui_steady_kingdom_n_1"
														}
													}
													button_standard = {
														size = { 100 26 }
														text = "pantheon_ui_btn_steady_kingdom"
														enabled = "[GetScriptedGui('pantheon_ui_steady_arm_kingdom').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_steady_title', Title.MakeScope ).End )]"
														tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_steady_arm_kingdom').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_steady_title', Title.MakeScope ).End ), Localize( 'pantheon_ui_steady_kingdom_after_tt' ), GetScriptedGui('pantheon_ui_steady_arm_kingdom').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_steady_title', Title.MakeScope ).End ) )]"
														onclick = "[GetScriptedGui('pantheon_ui_steady_arm_kingdom').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_steady_title', Title.MakeScope ).End )]"
													}
												}
											}
										}
									}
									expand = {}
								}
							}

							# armed: what it reaches, what it costs, what it does, Send and Cancel
							widget = {
								name = "pantheon_temple_sign_armed"
								visible = "[GetPlayer.MakeScope.Var('pantheon_steady_reach').IsSet]"
								size = { 690 100 }
								background = { using = Background_Area }
								hbox = {
									margin_left = 10
									margin_right = 10
									margin_top = 4
									spacing = 10
									vbox = {
										spacing = 2
										text_single = {
											visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_steady_reach').GetValue, '(CFixedPoint)1' )]"
											size = { 460 24 }
											autoresize = no
											align = left|vcenter
											text = "pantheon_ui_steady_armed_1"
										}
										text_single = {
											visible = "[And( GetPlayer.MakeScope.Var('pantheon_steady_kingdom').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_steady_reach').GetValue, '(CFixedPoint)2' ) )]"
											size = { 460 24 }
											autoresize = no
											align = left|vcenter
											text = "pantheon_ui_steady_armed_2"
											tooltip = "pantheon_ui_steady_armed_2"
										}
										text_single = {
											visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_steady_reach').GetValue, '(CFixedPoint)3' )]"
											size = { 460 24 }
											autoresize = no
											align = left|vcenter
											text = "pantheon_ui_steady_armed_3"
										}
										text_single = {
											visible = "[And3( GetPlayer.MakeScope.Var('pantheon_steady_count').IsSet, GetPlayer.MakeScope.Var('pantheon_steady_price').IsSet, GetPlayer.MakeScope.Var('pantheon_worship').IsSet )]"
											size = { 460 24 }
											autoresize = no
											align = left|vcenter
											text = "pantheon_ui_steady_armed_line"
											tooltip = "pantheon_ui_steady_armed_line"
										}
										text_single = {
											size = { 460 40 }
											multiline = yes
											autoresize = no
											align = left|top
											text = "pantheon_ui_steady_effects"
											tooltip = "pantheon_ui_steady_effects_tt"
										}
									}
									vbox = {
										spacing = 6
										button_standard = {
											size = { 200 32 }
											text = "pantheon_ui_btn_steady_send"
											enabled = "[GetScriptedGui('pantheon_ui_steady_send').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
											tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_steady_send').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Localize( 'pantheon_ui_steady_send_after_tt' ), GetScriptedGui('pantheon_ui_steady_send').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
											onclick = "[GetScriptedGui('pantheon_ui_steady_send').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										}
										button_standard = {
											size = { 200 32 }
											text = "pantheon_ui_btn_steady_cancel"
											tooltip = "pantheon_ui_steady_cancel_tt"
											onclick = "[GetScriptedGui('pantheon_ui_steady_cancel').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										}
									}
								}
							}
							# the spare height goes below the body
							expand = {}
						}
						# ---- end 2.9 Task 5
					}
							}
						}
					}
					# ---- end 2.12 Task 1 page scrollbox
				}
			}
		}
	}
}
