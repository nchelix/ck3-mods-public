															enabled = "[GetScriptedGui('pantheon_ui_retri_mortals').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_retri_attacker', Character.MakeScope ).End )]"
															tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_retri_mortals').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_retri_attacker', Character.MakeScope ).End ), Localize( 'pantheon_ui_retri_mortals_after_tt' ), GetScriptedGui('pantheon_ui_retri_mortals').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_retri_attacker', Character.MakeScope ).End ) )]"
															onclick = "[GetScriptedGui('pantheon_ui_retri_mortals').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_retri_attacker', Character.MakeScope ).End )]"
