					# 2.3 B5: the sworn oath (when one is on): who swore it, against whom, the wrong, and exactly what fulfils it.
					# A vbox with the panel background (a widget does not size to its children); the button re-opens the sworn
					# Judgement page on the offender. Not sworn: only the cooldown line, if a Great Prayer cannot reach you yet.
					# Fix round 1 (F7): the oath and the cooldown line sit under their own "Great Prayers" header, inside the
					# content area with normal padding (the lone status line used to hang on the window's bottom edge).
					vbox = {
						# Fix round 2 (H3): its own sub-tab (pantheon_ui_ptab 3), shown in full
						visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_ptab').GetValue, '(CFixedPoint)3' )]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 6
						text_single = {
							text = "pantheon_ui_greatp_header"
