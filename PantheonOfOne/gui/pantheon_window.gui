														size = { 92 46 }
														tooltip = "pantheon_temple_ladder_tt_4"
														icon = {
															visible = "[And( Not( And( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)4' ) ) ), Not( And( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').GetValue, '(CFixedPoint)4' ) ) ) )]"
															position = { 34 0 }
