																layoutpolicy_horizontal = expanding
																autoresize = no
																text = "pantheon_ui_wants_4"
															}
															text_single = {
																visible = "[EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_aspiration_kind').GetValue, '(CFixedPoint)5' )]"
																layoutpolicy_horizontal = expanding
																autoresize = no
