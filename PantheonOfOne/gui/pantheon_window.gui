									tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_oath_judge').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Localize( 'pantheon_ui_oath_judge_after_tt' ), GetScriptedGui('pantheon_ui_oath_judge').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
									onclick = "[GetScriptedGui('pantheon_ui_oath_judge').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								}
							}
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								text = "pantheon_ui_oath_who"
							}
							text_single = {
								visible = "[Or( Not( GetPlayer.MakeScope.Var('pantheon_great_prayer_kind').IsSet ), EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_great_prayer_kind').GetValue, '(CFixedPoint)0' ) )]"
								layoutpolicy_horizontal = expanding
								autoresize = no
								text = "pantheon_ui_oath_wrong_0"
							}
							text_single = {
								visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_great_prayer_kind').GetValue, '(CFixedPoint)1' )]"
								layoutpolicy_horizontal = expanding
								autoresize = no
								text = "pantheon_ui_oath_wrong_1"
							}
							text_single = {
								visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_great_prayer_kind').GetValue, '(CFixedPoint)2' )]"
								layoutpolicy_horizontal = expanding
								autoresize = no
								text = "pantheon_ui_oath_wrong_2"
							}
							text_single = {
								visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_great_prayer_kind').GetValue, '(CFixedPoint)3' )]"
								layoutpolicy_horizontal = expanding
