											text_single = {
												visible = "[And3( GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_temple_active_tier'), '(CFixedPoint)5' ), GetPlayer.MakeScope.Var('pantheon_temple_cooldown_months').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_cooldown_months').GetValue, '(CFixedPoint)1' ) )]"
												size = { 162 20 }
