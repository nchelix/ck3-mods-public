# Pantheon of One 2.0: the Pantheon window and the button that opens it. No vanilla file is replaced: both are
# registered in gui/scripted_widgets/pantheon_widgets.txt. Proven syntax: the spec's Task 0 section.

# The button by the portrait, for gods only (clear of the personal-faith button at { 20 -300 }: Task 0)
widget = {
	name = "pantheon_button"
	# No player yet (loading, main menu): the god check below would error every frame (round 2, error.log), so the
	# outer widget waits for a valid player and the inner button holds the scripted-GUI check, as Divine Intervention does
	visible = "[And( GetPlayer.IsValid, And( And( Not( IsPauseMenuShown ), Not( IsObserver ) ), IsDefaultGUIMode ) )]"
	parentanchor = bottom|left
	position = { 20 -360 }
	size = { 44 44 }
	layer = hud_layer

	button_round = {
		size = { 44 44 }
		visible = "[GetScriptedGui('pantheon_ui_is_god').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		onclick = "[GetScriptedGui('pantheon_ui_toggle').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		# Fix round 2 (H4): with prayers or calls waiting, a second line says how many
		# 2.9 (Task 4): a quiet prayer adds a line of its own, in all four combinations (popups waiting or not, quiet waiting or not)
		tooltip = "[Select_CString( GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_ui_open_prayer_count'), '(CFixedPoint)0' ), Select_CString( GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_ui_count_quiet'), '(CFixedPoint)0' ), Localize( 'pantheon_ui_button_tt_nq' ), Localize( 'pantheon_ui_button_tt_n' ) ), Select_CString( GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_ui_count_quiet'), '(CFixedPoint)0' ), Localize( 'pantheon_ui_button_tt_q' ), Localize( 'pantheon_ui_button_tt' ) ) )]"

		icon = {
			parentanchor = center
			alwaystransparent = yes
			size = { 30 30 }
			texture = "gfx/interface/icons/character_interactions/pantheon_divine_will_interaction.dds"
			modify_texture = {
				texture = "gfx/interface/component_masks/mask_circle.dds"
				blend_mode = alphamultiply
			}
		}
	}

	# Fix round 2 (H4): the count badge at the button's top-right corner, only while something waits. Vanilla's own
	# number-on-a-badge pattern: game/gui/hud.gui icon_power_sharing_level (highlight_icon + regency_level_button_badge.dds
	# + a centred text_single).
	highlight_icon = {
		visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_ui_open_prayer_count'), '(CFixedPoint)0' )]"
		parentanchor = top|right
		position = { 6 -6 }
		size = { 28 28 }
		alwaystransparent = yes
		texture = "gfx/interface/window_regency/regency_level_button_badge.dds"

		text_single = {
			align = nobaseline
			parentanchor = center
			text = "[GetPlayer.MakeScope.ScriptValue('pantheon_ui_open_prayer_count')|0]"
		}
	}

	# 2.9 (Task 4): a second badge for the quiet prayers, in the OPPOSITE corner (bottom right) and its own colour, so it reads apart
	# from the popup badge. It shows only the quiet count, never the popup count, and only while one waits. alwaystransparent like
	# the first, so it never steals the click from the button. In-game test (QP2, then Section C): neither `color` nor `tintcolor`
	# changes a highlight_icon's look, so the colour is in the texture: pantheon_quiet_badge.dds is vanilla's
	# regency_level_button_badge.dds recoloured blue.
	highlight_icon = {
		visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_ui_count_quiet'), '(CFixedPoint)0' )]"
		parentanchor = bottom|right
		position = { 6 6 }
		size = { 28 28 }
		alwaystransparent = yes
		texture = "gfx/interface/icons/pantheon_quiet_badge.dds"

		text_single = {
			align = nobaseline
			parentanchor = center
			text = "[GetPlayer.MakeScope.ScriptValue('pantheon_ui_count_quiet')|0]"
		}
	}
}

# The Pantheon window, shown while the god has pantheon_ui_open. Rows follow Divine Intervention's pinned-character
# list (in-game round 1): portrait, name, coloured skill boxes, then the follower's state underneath.
window = {
	name = "pantheon_window"
	position = { 0 20 }
	parentanchor = center
	layer = middle
	size = { 1000 900 }
	visible = "[And( GetPlayer.IsValid, GetPlayer.MakeScope.Var('pantheon_ui_open').IsSet )]"

	using = Window_Background
	using = Window_Decoration

	vbox = {
		margin = { 32 20 }
		spacing = 8
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		header_pattern = {
			datacontext = "[GetPlayer]"
			layoutpolicy_horizontal = expanding
			size = { 0 50 }
			blockoverride "header_text" {
				text = "pantheon_ui_title"
			}
			blockoverride "button_close" {
				onclick = "[GetScriptedGui('pantheon_ui_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}

		text_single = {
			text = "pantheon_ui_worship_line"
		}

		# The selected-follower strip (2.4 T5, layout A): across the whole window under the Worship line, visible on every
		# tab. It moved here from the Followers tab. A vbox, not a widget: a widget does not size to its children, so in
		# round 1 the pane collapsed under the list and its buttons could not be clicked. Gated on IsAlive (I3).
		vbox = {
			visible = "[And( GetPlayer.MakeScope.Var('pantheon_ui_target').IsSet, GetPlayer.MakeScope.Var('pantheon_ui_target').GetCharacter.IsAlive )]"
			datacontext = "[GetPlayer.MakeScope.Var('pantheon_ui_target').GetCharacter]"
			layoutpolicy_horizontal = expanding
			margin = { 8 8 }
			spacing = 6
			background = { using = Background_Area_With_Header }

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10
				portrait_head = {}
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 3
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							text = "[Character.GetUINameNoTooltip]"
							using = Font_Size_Medium
						}
						hbox_skills_grid_character_model = {}
						text_single = {
							minimumsize = { 44 0 }
							align = center|nobaseline
							text = "pantheon_ui_prowess"
						}
					}
					text_single = { text = "pantheon_ui_devotion_line" }
					text_single = {
						visible = "[Character.MakeScope.Var('pantheon_boon_trait').IsSet]"
						text = "pantheon_ui_boon_trait"
					}
					text_single = {
						visible = "[Character.MakeScope.Var('pantheon_boon_harvest').IsSet]"
						text = "pantheon_ui_boon_harvest"
					}
					text_single = {
						visible = "[Character.MakeScope.Var('pantheon_boon_walls').IsSet]"
						text = "pantheon_ui_boon_walls"
					}
					text_single = {
						visible = "[Character.MakeScope.Var('pantheon_boon_warding').IsSet]"
						text = "pantheon_ui_boon_warding"
					}
					text_single = {
						visible = "[Character.MakeScope.Var('pantheon_boon_vigor').IsSet]"
						text = "pantheon_ui_boon_vigor"
					}
					text_single = {
						visible = "[Character.MakeScope.Var('pantheon_boon_fertility').IsSet]"
						text = "pantheon_ui_boon_fertility"
					}
					text_single = {
						visible = "[Character.MakeScope.Var('pantheon_boon_lineage').IsSet]"
						text = "pantheon_ui_boon_lineage"
					}
					text_single = {
						visible = "[Character.MakeScope.Var('pantheon_boon_great').IsSet]"
						text = "pantheon_ui_boon_great"
					}
					text_single = {
						visible = "[Character.MakeScope.Var('pantheon_boon_prayer').IsSet]"
						text = "pantheon_ui_boon_prayer"
					}
					text_single = {
						visible = "[Character.MakeScope.Var('pantheon_boon_debt').IsSet]"
						text = "pantheon_ui_boon_debt"
					}
					text_single = {
						visible = "[Character.MakeScope.Var('pantheon_boon_conception').IsSet]"
						text = "pantheon_ui_boon_conception"
					}
					text_single = {
						visible = "[Character.MakeScope.Var('pantheon_boon_freedom').IsSet]"
						text = "pantheon_ui_boon_freedom"
					}
					text_single = {
						visible = "[And( Character.MakeScope.Var('pantheon_grievance').IsSet, Character.MakeScope.Var('pantheon_grievance_target').GetCharacter.IsAlive )]"
						text = "pantheon_ui_grievance_line"
					}
					text_single = {
						visible = "[And3( GetScriptedGui('pantheon_ui_boon_valid').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End ), Character.MakeScope.Var('pantheon_aspiration').IsSet, EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_aspiration_kind').GetValue, '(CFixedPoint)1' ) )]"
						text = "pantheon_ui_wants_1"
						tooltip = "pantheon.0066.grant_crown.tt"
					}
					text_single = {
						visible = "[And3( GetScriptedGui('pantheon_ui_boon_valid').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End ), Character.MakeScope.Var('pantheon_aspiration').IsSet, EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_aspiration_kind').GetValue, '(CFixedPoint)2' ) )]"
						text = "pantheon_ui_wants_2"
						tooltip = "pantheon.0066.grant_kin.tt"
					}
					text_single = {
						visible = "[And3( GetScriptedGui('pantheon_ui_boon_valid').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End ), Character.MakeScope.Var('pantheon_aspiration').IsSet, EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_aspiration_kind').GetValue, '(CFixedPoint)3' ) )]"
						text = "pantheon_ui_wants_3"
						tooltip = "pantheon.0066.grant_war.tt"
					}
					text_single = {
						visible = "[And3( GetScriptedGui('pantheon_ui_boon_valid').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End ), Character.MakeScope.Var('pantheon_aspiration').IsSet, EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_aspiration_kind').GetValue, '(CFixedPoint)4' ) )]"
						text = "pantheon_ui_wants_4"
						tooltip = "pantheon.0066.grant_heir.tt"
					}
					text_single = {
						visible = "[And3( GetScriptedGui('pantheon_ui_boon_valid').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End ), Character.MakeScope.Var('pantheon_aspiration').IsSet, EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_aspiration_kind').GetValue, '(CFixedPoint)5' ) )]"
						text = "pantheon_ui_wants_5"
						tooltip = "pantheon.0066.grant_conversion.tt"
					}
					text_single = {
						visible = "[And3( GetScriptedGui('pantheon_ui_boon_valid').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End ), Character.MakeScope.Var('pantheon_aspiration').IsSet, EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_aspiration_kind').GetValue, '(CFixedPoint)6' ) )]"
						text = "pantheon_ui_wants_6"
						tooltip = "pantheon.0066.grant_fortune.tt"
					}
					text_single = {
						visible = "[And4( GetScriptedGui('pantheon_ui_boon_valid').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End ), Character.MakeScope.Var('pantheon_aspiration').IsSet, EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_aspiration_kind').GetValue, '(CFixedPoint)7' ), Not( Character.MakeScope.Var('pantheon_aspiration_target').IsSet ) )]"
						text = "pantheon_ui_wants_7"
						tooltip = "pantheon.0066.grant_freedom.tt"
					}
					# 2.5: a kind 7 raised by kin names the prisoner
					text_single = {
						visible = "[And4( GetScriptedGui('pantheon_ui_boon_valid').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End ), Character.MakeScope.Var('pantheon_aspiration').IsSet, EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_aspiration_kind').GetValue, '(CFixedPoint)7' ), Character.MakeScope.Var('pantheon_aspiration_target').IsSet )]"
						text = "pantheon_ui_wants_7_kin"
						tooltip = "pantheon.0066.grant_kin_freedom.tt"
					}
				}
			}

			# Fixed-size buttons: 6 x 110 + Change 80 + Clear 80 + 7 gaps of 6 = 862, inside the 920 the card has (936 less its margins).
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6
				button_standard = {
					size = { 110 30 }
					text = "pantheon_ui_btn_bless"
					visible = "[Character.IsPlayerInteractionShown('pantheon_bless_interaction')]"
					enabled = "[Character.IsPlayerInteractionValid('pantheon_bless_interaction')]"
					tooltip = "[Character.GetPlayerInteractionTooltip('pantheon_bless_interaction')]"
					onclick = "[Character.OpenPlayerInteraction('pantheon_bless_interaction')]"
				}
				button_standard = {
					size = { 110 30 }
					text = "pantheon_ui_btn_lend"
					visible = "[Character.IsPlayerInteractionShown('pantheon_lend_interaction')]"
					enabled = "[Character.IsPlayerInteractionValid('pantheon_lend_interaction')]"
					tooltip = "[Character.GetPlayerInteractionTooltip('pantheon_lend_interaction')]"
					onclick = "[Character.OpenPlayerInteraction('pantheon_lend_interaction')]"
				}
				button_standard = {
					size = { 110 30 }
					text = "pantheon_ui_btn_wed"
					visible = "[Character.IsPlayerInteractionShown('pantheon_wed_interaction')]"
					enabled = "[Character.IsPlayerInteractionValid('pantheon_wed_interaction')]"
					tooltip = "[Character.GetPlayerInteractionTooltip('pantheon_wed_interaction')]"
					onclick = "[Character.OpenPlayerInteraction('pantheon_wed_interaction')]"
				}
				button_standard = {
					size = { 110 30 }
					text = "pantheon_ui_btn_judge"
					visible = "[Character.IsPlayerInteractionShown('pantheon_judgement_interaction')]"
					enabled = "[Character.IsPlayerInteractionValid('pantheon_judgement_interaction')]"
					tooltip = "[Character.GetPlayerInteractionTooltip('pantheon_judgement_interaction')]"
					onclick = "[Character.OpenPlayerInteraction('pantheon_judgement_interaction')]"
				}
				button_standard = {
					size = { 110 30 }
					text = "pantheon_ui_btn_lands"
					visible = "[Character.IsPlayerInteractionShown('pantheon_lands_interaction')]"
					enabled = "[Character.IsPlayerInteractionValid('pantheon_lands_interaction')]"
					tooltip = "[Character.GetPlayerInteractionTooltip('pantheon_lands_interaction')]"
					onclick = "[Character.OpenPlayerInteraction('pantheon_lands_interaction')]"
				}
				expand = {}
				button_standard = {
					size = { 80 30 }
					text = "pantheon_ui_btn_change"
					tooltip = "pantheon_ui_btn_change_tt"
					onclick = "[GetScriptedGui('pantheon_ui_tab_followers').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
				button_standard = {
					size = { 80 30 }
					text = "pantheon_ui_btn_clear"
					tooltip = "pantheon_ui_btn_clear_tt"
					onclick = "[GetScriptedGui('pantheon_ui_clear').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
			}
			hbox = {
				visible = "[Or( Character.IsPlayerInteractionShown('pantheon_great_boon_interaction'), GetScriptedGui('pantheon_ui_row_answer').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End ) )]"
				layoutpolicy_horizontal = expanding
				spacing = 6
				button_standard = {
					size = { 180 30 }
					text = "pantheon_ui_btn_boon"
					visible = "[Character.IsPlayerInteractionShown('pantheon_great_boon_interaction')]"
					enabled = "[Character.IsPlayerInteractionValid('pantheon_great_boon_interaction')]"
					tooltip = "[Select_CString( Character.IsPlayerInteractionValid('pantheon_great_boon_interaction'), Localize( 'pantheon_ui_boon_btn_tt' ), Character.GetPlayerInteractionTooltip('pantheon_great_boon_interaction') )]"
					onclick = "[Character.OpenPlayerInteraction('pantheon_great_boon_interaction')]"
				}
				# 2.5 repair 1: answer the selected follower's grievance unasked, the Followers row button's scripted GUI
				button_standard = {
					size = { 110 30 }
					text = "pantheon_ui_btn_answer"
					visible = "[GetScriptedGui('pantheon_ui_row_answer').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End )]"
					enabled = "[GetScriptedGui('pantheon_ui_row_answer').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End )]"
					tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_row_answer').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End ), Localize( 'pantheon_ui_answer_tt' ), GetScriptedGui('pantheon_ui_row_answer').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End ) )]"
					onclick = "[GetScriptedGui('pantheon_ui_row_answer').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_row_follower', Character.MakeScope ).End )]"
				}
				expand = {}
			}
		}

		# No follower selected: visible exactly when the card above is not (its complement).
		hbox = {
			visible = "[Not( And( GetPlayer.MakeScope.Var('pantheon_ui_target').IsSet, GetPlayer.MakeScope.Var('pantheon_ui_target').GetCharacter.IsAlive ) )]"
			layoutpolicy_horizontal = expanding
			margin = { 8 4 }
			spacing = 6
			background = { using = Background_Area_With_Header }
			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				text = "pantheon_ui_strip_none"
			}
			button_standard = {
				size = { 80 30 }
				text = "pantheon_ui_btn_change"
				tooltip = "pantheon_ui_btn_change_tt"
				onclick = "[GetScriptedGui('pantheon_ui_tab_followers').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}

		# The tabs, a left sidebar column like One Trait's (2.3 B1): 1 Followers, 5 Prayers, 2 Children, 3 The God,
		# 4 The Temple. Values are kept from 2.2 (Prayers is the new 5) so an old save's stored tab stays valid.
		# Fixed 170x40 buttons and a trailing expand = {} keep the column top-aligned and its width deterministic.
		# Content width: 1000 window - 64 margin - 186 sidebar (170 + 2*8 margin) - 8 spacing = 742, less a 20 right margin
		# (fix round 1) so no tab runs flush to the frame = 722.
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 8
			vbox = {
				layoutpolicy_vertical = expanding
				margin = { 8 8 }
				spacing = 4
				background = { using = Background_Area_Dark }
				button_standard = {
					layoutpolicy_horizontal = fixed
					size = { 170 40 }
					onclick = "[GetScriptedGui('pantheon_ui_tab_followers').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_tab').GetValue, '(CFixedPoint)1' )]"
					hbox = {
						spacing = 3
						icon = {
							size = { 22 22 }
							texture = "gfx/interface/icons/pantheon/pantheon_tab_followers.dds"
						}
						text_single = { text = "pantheon_ui_tab_followers" }
					}
				}
				button_standard = {
					layoutpolicy_horizontal = fixed
					size = { 170 40 }
					onclick = "[GetScriptedGui('pantheon_ui_tab_prayers').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_tab').GetValue, '(CFixedPoint)5' )]"
					hbox = {
						spacing = 3
						icon = {
							size = { 22 22 }
							texture = "gfx/interface/icons/pantheon/pantheon_tab_prayers.dds"
						}
						text_single = {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_ui_open_prayer_count'), '(CFixedPoint)0' )]"
							text = "pantheon_ui_tab_prayers"
						}
						text_single = {
							visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_ui_open_prayer_count'), '(CFixedPoint)0' )]"
							text = "pantheon_ui_tab_prayers_n"
						}
					}
				}
				button_standard = {
					layoutpolicy_horizontal = fixed
					size = { 170 40 }
					onclick = "[GetScriptedGui('pantheon_ui_tab_children').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_tab').GetValue, '(CFixedPoint)2' )]"
					hbox = {
						spacing = 3
						icon = {
							size = { 22 22 }
							texture = "gfx/interface/icons/traits/pantheon_demigod.dds"
						}
						text_single = { text = "pantheon_ui_tab_children" }
					}
				}
				button_standard = {
					layoutpolicy_horizontal = fixed
					size = { 170 40 }
					onclick = "[GetScriptedGui('pantheon_ui_tab_god').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_tab').GetValue, '(CFixedPoint)3' )]"
					hbox = {
						spacing = 3
						icon = {
							size = { 22 22 }
							texture = "gfx/interface/icons/traits/pantheon_divine.dds"
						}
						text_single = { text = "pantheon_ui_tab_god" }
					}
				}
				button_standard = {
					layoutpolicy_horizontal = fixed
					size = { 170 40 }
					onclick = "[GetScriptedGui('pantheon_ui_tab_temple').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_tab').GetValue, '(CFixedPoint)4' )]"
					hbox = {
						spacing = 3
						icon = {
							size = { 22 22 }
							texture = "gfx/interface/icons/pantheon/pantheon_tab_temple.dds"
						}
						text_single = { text = "pantheon_ui_tab_temple" }
					}
				}
				expand = {}
			}

			# Content (right): the tab bodies; fixed-width rows below fit the 722px width (742 less the 20px right margin).
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin_right = 20
				spacing = 8

				# ---- Tab 5: Prayers (2.3 B3). The open prayers, oldest first (pantheon_ui_prayers, built by
				# pantheon_ui_rebuild_effect). Rows are fixed-size cells of the same grid form as the follower rows.
				vbox = {
					visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_tab').GetValue, '(CFixedPoint)5' )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 8
					# Fix round 2 (H3): the Prayers tab's sub-tabs. pantheon_ui_ptab: 1 Prayers (also when absent), 2 Retribution,
					# 3 Great Prayers. Vanilla tab buttons (button_tab, as the character window's Family/Relations/Court tabs; polish
					# 2026-10-21), the count beside the label only when above 0; one section is shown below at the tab's full height.
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 0

						button_tab = {
							onclick = "[GetScriptedGui('pantheon_ui_ptab_prayers').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[Or( Not( GetPlayer.MakeScope.Var('pantheon_ui_ptab').IsSet ), EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_ptab').GetValue, '(CFixedPoint)1' ) )]"
							blockoverride "tab_label" {
								text = "pantheon_ui_ptab_prayers"
							}
							blockoverride "extra_info" {
								text_single = {
									visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_ui_count_prayers'), '(CFixedPoint)0' )]"
									text = "[GetPlayer.MakeScope.ScriptValue('pantheon_ui_count_prayers')|0]"
									align = nobaseline
									default_format = "#low"
									margin_top = 3
								}
							}
						}
						button_tab = {
							onclick = "[GetScriptedGui('pantheon_ui_ptab_retris').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_ptab').GetValue, '(CFixedPoint)2' )]"
							blockoverride "tab_label" {
								text = "pantheon_ui_ptab_retris"
							}
							blockoverride "extra_info" {
								text_single = {
									visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_ui_count_retris'), '(CFixedPoint)0' )]"
									text = "[GetPlayer.MakeScope.ScriptValue('pantheon_ui_count_retris')|0]"
									align = nobaseline
									default_format = "#low"
									margin_top = 3
								}
							}
						}
						button_tab = {
							onclick = "[GetScriptedGui('pantheon_ui_ptab_great').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_ptab').GetValue, '(CFixedPoint)3' )]"
							blockoverride "tab_label" {
								text = "pantheon_ui_ptab_great"
							}
							blockoverride "extra_info" {
								text_single = {
									visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_ui_count_great'), '(CFixedPoint)0' )]"
									text = "[GetPlayer.MakeScope.ScriptValue('pantheon_ui_count_great')|0]"
									align = nobaseline
									default_format = "#low"
									margin_top = 3
								}
							}
						}
						# 2.9 (Task 4): the fourth sub-tab, Quiet prayers (pantheon_ui_ptab 4); the count shows only above 0
						button_tab = {
							onclick = "[GetScriptedGui('pantheon_ui_ptab_quiet').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_ptab').GetValue, '(CFixedPoint)4' )]"
							blockoverride "tab_label" {
								text = "pantheon_ui_ptab_quiet"
							}
							blockoverride "extra_info" {
								text_single = {
									visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_ui_count_quiet'), '(CFixedPoint)0' )]"
									text = "[GetPlayer.MakeScope.ScriptValue('pantheon_ui_count_quiet')|0]"
									align = nobaseline
									default_format = "#low"
									margin_top = 3
								}
							}
						}
					}

					text_single = {
						visible = "[Or( Not( GetPlayer.MakeScope.Var('pantheon_ui_ptab').IsSet ), EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_ptab').GetValue, '(CFixedPoint)1' ) )]"
						text = "pantheon_ui_prayers_header"
						using = Font_Size_Medium
					}
					scrollbox = {
						visible = "[Or( Not( GetPlayer.MakeScope.Var('pantheon_ui_ptab').IsSet ), EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_ptab').GetValue, '(CFixedPoint)1' ) )]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_empty" {
							text = "pantheon_ui_prayers_empty"
							visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList('pantheon_ui_prayers') )]"
						}
						blockoverride "scrollbox_content" {
							vbox = {
								fixedgridbox = {
									datamodel = "[GetPlayer.MakeScope.GetList('pantheon_ui_prayers')]"
									addcolumn = 680
									addrow = 120
									setitemsizefromcell = yes
									item = {
										widget = {
											size = { 676 116 }
											visible = "[Scope.GetCharacter.MakeScope.Var('pantheon_prayer_open').IsSet]"
											datacontext = "[Scope.GetCharacter]"
											background = { using = Background_Area }
											hbox = {
												margin_left = 6
												margin_right = 10
												margin_top = 4
												spacing = 8
												portrait_head_small = {}
												vbox = {
													layoutpolicy_horizontal = expanding
													spacing = 2
													hbox = {
														layoutpolicy_horizontal = expanding
														spacing = 8
														text_single = {
															layoutpolicy_horizontal = expanding
															autoresize = no
															text = "[Character.GetUINameNoTooltip]"
														}
														text_single = {
															visible = "[EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_origin').GetValue, '(CFixedPoint)2' )]"
															text = "pantheon_ui_prayer_stranger"
														}
														text_single = {
															size = { 190 26 }
															autoresize = no
															align = right|vcenter
															text = "pantheon_ui_prayer_time"
														}
													}
													text_single = {
														visible = "[Not( EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_need').GetValue, '(CFixedPoint)10' ) )]"
														layoutpolicy_horizontal = expanding
														autoresize = no
														text = "pantheon_ui_prayer_need_line"
													}
													# 2.5 (R6): a relative's prayer names the prisoner (a character variable, as pantheon_ui_grievance_line reads one)
													text_single = {
														visible = "[EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_need').GetValue, '(CFixedPoint)10' )]"
														layoutpolicy_horizontal = expanding
														autoresize = no
														text = "pantheon_ui_prayer_need_line_kin"
													}
													text_single = {
														visible = "[And3( EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_origin').GetValue, '(CFixedPoint)1' ), Not( EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_need').GetValue, '(CFixedPoint)9' ) ), Not( EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_need').GetValue, '(CFixedPoint)10' ) ) )]"
														layoutpolicy_horizontal = expanding
														autoresize = no
														text = "pantheon_ui_prayer_price_follower"
													}
													text_single = {
														visible = "[And( EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_origin').GetValue, '(CFixedPoint)1' ), EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_need').GetValue, '(CFixedPoint)9' ) )]"
														layoutpolicy_horizontal = expanding
														autoresize = no
														text = "pantheon_ui_prayer_price_freedom"
													}
													# 2.5 (R6): need 10 reads the PRISONER's Devotion value, not the row character's
													text_single = {
														visible = "[And( EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_origin').GetValue, '(CFixedPoint)1' ), EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_need').GetValue, '(CFixedPoint)10' ) )]"
														layoutpolicy_horizontal = expanding
														autoresize = no
														text = "pantheon_ui_prayer_price_kin_freedom"
													}
													text_single = {
														visible = "[EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_origin').GetValue, '(CFixedPoint)2' )]"
														layoutpolicy_horizontal = expanding
														autoresize = no
														text = "pantheon_ui_prayer_price_stranger"
													}
													hbox = {
														layoutpolicy_horizontal = expanding
														spacing = 6
													button_standard = {
														size = { 110 30 }
														text = "pantheon_ui_btn_prayer_grant"
														enabled = "[GetScriptedGui('pantheon_ui_prayer_grant').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
														tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_prayer_grant').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ), Select_CString( EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_need').GetValue, '(CFixedPoint)10' ), Localize( 'pantheon_ui_prayer_grant_after_kin_freedom_tt' ), Select_CString( EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_need').GetValue, '(CFixedPoint)9' ), Localize( 'pantheon_ui_prayer_grant_after_freedom_tt' ), Localize( 'pantheon_ui_prayer_grant_after_tt' ) ) ), GetScriptedGui('pantheon_ui_prayer_grant').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ) )]"
														onclick = "[GetScriptedGui('pantheon_ui_prayer_grant').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
													}
													button_standard = {
														size = { 120 30 }
														visible = "[EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_origin').GetValue, '(CFixedPoint)1' )]"
														text = "pantheon_ui_btn_prayer_sign"
														enabled = "[GetScriptedGui('pantheon_ui_prayer_sign').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
														tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_prayer_sign').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ), Localize( 'pantheon_ui_prayer_sign_after_tt' ), GetScriptedGui('pantheon_ui_prayer_sign').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ) )]"
														onclick = "[GetScriptedGui('pantheon_ui_prayer_sign').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
													}
													button_standard = {
														size = { 130 30 }
														visible = "[And( EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_origin').GetValue, '(CFixedPoint)1' ), Or( EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_need').GetValue, '(CFixedPoint)1' ), EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_need').GetValue, '(CFixedPoint)8' ) ) )]"
														text = "pantheon_ui_btn_prayer_send"
														enabled = "[GetScriptedGui('pantheon_ui_prayer_send').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
														tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_prayer_send').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ), Localize( 'pantheon_ui_prayer_send_after_tt' ), GetScriptedGui('pantheon_ui_prayer_send').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ) )]"
														onclick = "[GetScriptedGui('pantheon_ui_prayer_send').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
													}
													button_standard = {
														size = { 100 30 }
														visible = "[EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_origin').GetValue, '(CFixedPoint)1' )]"
														text = "pantheon_ui_btn_prayer_refuse"
														enabled = "[GetScriptedGui('pantheon_ui_prayer_refuse').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
														tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_prayer_refuse').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ), Localize( 'pantheon_ui_prayer_refuse_after_tt' ), GetScriptedGui('pantheon_ui_prayer_refuse').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ) )]"
														onclick = "[GetScriptedGui('pantheon_ui_prayer_refuse').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
													}
													button_standard = {
														size = { 140 30 }
														visible = "[EqualTo_CFixedPoint( Character.MakeScope.Var('pantheon_prayer_origin').GetValue, '(CFixedPoint)2' )]"
														text = "pantheon_ui_btn_prayer_dismiss"
														enabled = "[GetScriptedGui('pantheon_ui_prayer_dismiss').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
														tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_prayer_dismiss').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ), Localize( 'pantheon_ui_prayer_dismiss_after_tt' ), GetScriptedGui('pantheon_ui_prayer_dismiss').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ) )]"
														onclick = "[GetScriptedGui('pantheon_ui_prayer_dismiss').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
													}
														expand = {}
