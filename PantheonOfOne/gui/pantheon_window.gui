														}
														icon = {
															visible = "[And( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').GetValue, '(CFixedPoint)4' ) )]"
															position = { 34 0 }
