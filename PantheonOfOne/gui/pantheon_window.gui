							visible = "[Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList('pantheon_ui_waiting_boons') ) )]"
							text = "pantheon_ui_waiting_boons_header"
							using = Font_Size_Medium
						}
						# 2.6 (UI retest): scrolls when the waiting boons outgrow the panel, and takes the spare height so the lines above stay together
						scrollbox = {
							visible = "[Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList('pantheon_ui_waiting_boons') ) )]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
