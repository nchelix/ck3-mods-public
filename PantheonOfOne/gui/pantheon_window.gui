				}

				# ---- Tab 1: Followers
				vbox = {
					visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_tab').GetValue, '(CFixedPoint)1' )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 6
					# 2.7: the Followers tab's sub-tabs, as the Prayers tab's. pantheon_ui_ftab: 1 Followers (also when absent), 2 Lost
					# followers, 3 Alerts. Tab 1 is the old tab, unchanged, in its own vbox.
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 0

						button_tab = {
							onclick = "[GetScriptedGui('pantheon_ui_ftab_1').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[Or( Not( GetPlayer.MakeScope.Var('pantheon_ui_ftab').IsSet ), EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_ftab').GetValue, '(CFixedPoint)1' ) )]"
							blockoverride "tab_label" {
								text = "pantheon_ui_ftab_1"
							}
						}
						button_tab = {
							onclick = "[GetScriptedGui('pantheon_ui_ftab_2').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_ftab').GetValue, '(CFixedPoint)2' )]"
							blockoverride "tab_label" {
								text = "pantheon_ui_ftab_2"
							}
						}
						button_tab = {
							onclick = "[GetScriptedGui('pantheon_ui_ftab_3').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_ftab').GetValue, '(CFixedPoint)3' )]"
							blockoverride "tab_label" {
								text = "pantheon_ui_ftab_3"
							}
						}
					}

					vbox = {
						visible = "[Or( Not( GetPlayer.MakeScope.Var('pantheon_ui_ftab').IsSet ), EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_ftab').GetValue, '(CFixedPoint)1' ) )]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 6

						# The selected follower now lives in the strip under the Worship line (2.4 T5), visible on every tab.

						# Sort and filter
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4
							text_single = { text = "pantheon_ui_sort_by" }
							button_standard = {
								size = { 110 30 }
								text = "pantheon_ui_sort_devotion"
								tooltip = "pantheon_ui_sort_devotion_tt"
								down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_sort').GetValue, '(CFixedPoint)0' )]"
								onclick = "[GetScriptedGui('pantheon_ui_sort_0').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}
							button_standard = {
								size = { 44 30 }
								text = "pantheon_ui_sort_dip"
								tooltip = "pantheon_ui_sort_dip_tt"
								down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_sort').GetValue, '(CFixedPoint)1' )]"
								onclick = "[GetScriptedGui('pantheon_ui_sort_1').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}
							button_standard = {
								size = { 44 30 }
								text = "pantheon_ui_sort_mar"
								tooltip = "pantheon_ui_sort_mar_tt"
								down = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_sort').GetValue, '(CFixedPoint)2' )]"
								onclick = "[GetScriptedGui('pantheon_ui_sort_2').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}
							button_standard = {
								size = { 44 30 }
