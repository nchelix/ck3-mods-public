					}

					# ---- 2.9 Task 4: the Quiet sub-tab (pantheon_ui_ptab 4). Followers whose Devotion is slipping pray in silence; the
					# god sees them here only. A kingdom summary (the top five kingdoms by count, pantheon_ui_quiet_kingdoms) sits above
					# the rows (pantheon_ui_quiet, weakest Devotion first), both built by pantheon_ui_rebuild_effect. LAYOUT BUDGET: the
					# tab content gets about 504 px under the tallest selected-follower strip (the Seeded lands' 290 box lives in the same
					# budget): sub-tabs 42 (vanilla button_tab) + 8, header 26 + 6, summary 5 rows x 26 + 4 x 2 = 138 + 6, then a FIXED 270
					# scrollbox (98-high cells, about two and three-quarter visible) = 496. Every text has a fixed size and elides at its width (max_width), the full text in a tooltip; no text
					# sizes itself, so a long localized name or kingdom can never push a row wider or taller. Row width: 6 margin + 85
					# portrait + 8 + the widest line (200 + 110 + 120 + 2 x 6 = 442; 330 + 220 + 6 = 556) + 10 margin = 665 of 676.
					vbox = {
						visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_ptab').GetValue, '(CFixedPoint)4' )]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 6
						text_single = {
							size = { 676 26 }
							autoresize = no
							text = "pantheon_ui_quiet_header"
							tooltip = "pantheon_ui_quiet_header_tt"
							using = Font_Size_Medium
						}
						# the kingdom summary: one 26-high row per kingdom, at most five, none when no quiet prayer has a kingdom.
						# The Task 5 "Steady <kingdom>" button joins these rows later (the width after the count is left free for it).
						vbox = {
							layoutpolicy_horizontal = expanding
							datamodel = "[GetPlayer.MakeScope.GetList('pantheon_ui_quiet_kingdoms')]"
							spacing = 2
							item = {
								widget = {
									size = { 660 26 }
									visible = "[Scope.GetLandedTitle.MakeScope.Var('pantheon_ui_quiet_n').IsSet]"
									datacontext = "[Scope.GetLandedTitle]"
									background = { using = Background_Area }
									hbox = {
										margin_left = 10
										margin_right = 10
										spacing = 8
										text_single = {
											size = { 300 24 }
											max_width = 300
											autoresize = no
											align = left|vcenter
											text = "[Title.GetNameNoTooltip]"
											tooltip = "[Title.GetNameNoTooltip]"
										}
										text_single = {
											size = { 140 24 }
											autoresize = no
											align = left|vcenter
											text = "pantheon_ui_quiet_kingdom_n"
										}
										# 2.9 Task 5: arm the steadying act at this kingdom (it opens the Temple tab, where the armed panel is)
										button_standard = {
											size = { 170 24 }
											text = "pantheon_ui_btn_steady_kingdom"
											enabled = "[GetScriptedGui('pantheon_ui_steady_arm_kingdom').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_steady_title', Title.MakeScope ).End )]"
											tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_steady_arm_kingdom').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_steady_title', Title.MakeScope ).End ), Localize( 'pantheon_ui_steady_kingdom_after_tt' ), GetScriptedGui('pantheon_ui_steady_arm_kingdom').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_steady_title', Title.MakeScope ).End ) )]"
											onclick = "[GetScriptedGui('pantheon_ui_steady_arm_kingdom').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_steady_title', Title.MakeScope ).End )]"
										}
									}
								}
							}
						}
						# the prayer rows. In-game test (Section A): a fixed 270 cut off early with room to spare below, so the box now takes
						# all the height left, as the Prayers sub-tab's list does (proven in game); it can never overflow the tab
						scrollbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							blockoverride "scrollbox_empty" {
								text = "pantheon_ui_quiet_empty"
								visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList('pantheon_ui_quiet') )]"
							}
							blockoverride "scrollbox_content" {
								vbox = {
									fixedgridbox = {
										datamodel = "[GetPlayer.MakeScope.GetList('pantheon_ui_quiet')]"
										addcolumn = 680
										addrow = 98
										setitemsizefromcell = yes
										item = {
											widget = {
												size = { 676 94 }
												visible = "[Scope.GetCharacter.MakeScope.Var('pantheon_quiet_open').IsSet]"
												datacontext = "[Scope.GetCharacter]"
												background = { using = Background_Area }
												hbox = {
													margin_left = 6
													margin_right = 10
													margin_top = 4
													spacing = 8
													portrait_head_small = {}
													vbox = {
														layoutpolicy_horizontal = expanding
														spacing = 2
														hbox = {
															layoutpolicy_horizontal = expanding
															spacing = 6
															text_single = {
																size = { 200 24 }
																max_width = 200
																autoresize = no
																align = left|vcenter
																text = "[Character.GetUINameNoTooltip]"
																tooltip = "[Character.GetUINameNoTooltip]"
															}
															text_single = {
																size = { 110 24 }
																autoresize = no
																align = left|vcenter
																text = "pantheon_ui_quiet_devotion"
															}
															text_single = {
																size = { 120 24 }
																autoresize = no
																align = left|vcenter
																text = "pantheon_ui_quiet_left"
															}
														}
														hbox = {
															layoutpolicy_horizontal = expanding
															spacing = 6
															text_single = {
																size = { 330 24 }
																max_width = 330
																autoresize = no
																align = left|vcenter
																text = "[Character.Custom('pantheon_prayer_need_words')]"
																tooltip = "[Character.Custom('pantheon_prayer_need_words')]"
															}
															text_single = {
																visible = "[Character.MakeScope.Var('pantheon_quiet_kingdom').IsSet]"
																size = { 220 24 }
																max_width = 220
																autoresize = no
																align = left|vcenter
																text = "pantheon_ui_quiet_kingdom"
																tooltip = "[Character.MakeScope.Var('pantheon_quiet_kingdom').GetLandedTitle.GetNameNoTooltip]"
															}
															text_single = {
																visible = "[Not( Character.MakeScope.Var('pantheon_quiet_kingdom').IsSet )]"
																size = { 220 24 }
																max_width = 220
																autoresize = no
																align = left|vcenter
																text = "pantheon_ui_quiet_no_kingdom"
															}
														}
														hbox = {
															layoutpolicy_horizontal = expanding
															spacing = 6
															button_standard = {
																size = { 170 30 }
																text = "pantheon_ui_btn_quiet_answer"
																enabled = "[GetScriptedGui('pantheon_ui_quiet_answer').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
																tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_quiet_answer').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ), Localize( 'pantheon_ui_quiet_answer_after_tt' ), GetScriptedGui('pantheon_ui_quiet_answer').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ) )]"
																onclick = "[GetScriptedGui('pantheon_ui_quiet_answer').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
															}
															button_standard = {
																size = { 140 30 }
																text = "pantheon_ui_btn_quiet_pass"
																enabled = "[GetScriptedGui('pantheon_ui_quiet_pass').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
																tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_quiet_pass').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ), Localize( 'pantheon_ui_quiet_pass_after_tt' ), GetScriptedGui('pantheon_ui_quiet_pass').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End ) )]"
																onclick = "[GetScriptedGui('pantheon_ui_quiet_pass').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'pantheon_suppliant', Character.MakeScope ).End )]"
															}
															expand = {}
