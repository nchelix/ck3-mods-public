															using = Font_Size_Small
															alwaystransparent = yes
															text = "building_type_pantheon_great_temple_04"
														}
													}
													widget = {
														name = "pantheon_temple_marker_5"
														size = { 92 46 }
														tooltip = "pantheon_temple_ladder_tt_5"
														icon = {
															visible = "[And( Not( And( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ) ) ), Not( And( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').GetValue, '(CFixedPoint)5' ) ) ) )]"
															position = { 34 0 }
															size = { 24 24 }
															alwaystransparent = yes
															texture = "gfx/interface/icons/pantheon/pantheon_temple_marker_empty.dds"
														}
														icon = {
															visible = "[And( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ) )]"
															position = { 34 0 }
															size = { 24 24 }
															alwaystransparent = yes
															texture = "gfx/interface/icons/pantheon/pantheon_temple_marker_filled.dds"
														}
														icon = {
															visible = "[And( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').GetValue, '(CFixedPoint)5' ) )]"
															position = { 34 0 }
															size = { 24 24 }
															alwaystransparent = yes
															texture = "gfx/interface/icons/pantheon/pantheon_temple_marker_dashed.dds"
														}
														text_single = {
															position = { 0 28 }
															size = { 92 18 }
															autoresize = no
															align = center|nobaseline
															using = Font_Size_Small
															alwaystransparent = yes
															text = "building_type_pantheon_great_temple_05"
														}
													}
												}
											}

											# The bottom row, one of three in the same 476 x 32: Upgrade and the next tier's cost and time
											# (nothing building), the build's progress and months left (building, paused or not), or the
											# complete line (tier 5). The Upgrade button keeps its four expressions verbatim; Test A repair
											# (row A4): its label names the tier it builds ("Upgrade to Great Temple", about 207 px of 260).
											# The row's own Worship IsSet (set from ascension on) guards the Worship read in the cost line's tooltip.
											widget = {
												name = "pantheon_temple_bottom_row"
												size = { 476 32 }
												hbox = {
													name = "pantheon_temple_upgrade_row"
													visible = "[And( GetPlayer.MakeScope.Var('pantheon_worship').IsSet, Not( GetPlayer.MakeScope.Var('pantheon_temple_building').IsSet ) )]"
													size = { 476 32 }
													spacing = 10
													button_standard = {
														size = { 260 32 }
														text = "pantheon_ui_btn_temple_upgrade_to"
														visible = "[GetScriptedGui('pantheon_ui_temple_upgrade').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
														enabled = "[GetScriptedGui('pantheon_ui_temple_upgrade').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
														tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_temple_upgrade').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Localize( 'pantheon_temple_upgrade_after_tt' ), GetScriptedGui('pantheon_ui_temple_upgrade').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
														onclick = "[GetScriptedGui('pantheon_ui_temple_upgrade').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
													}
													# Batch 2r1 (repair 5), Test A repair (row A4): what the next tier costs, one line of the regular
													# font centred on the button ("16,000 Worship · 5 years", about 180 px of 206). The tooltip gives
													# the whole next line (tier, cost, time) and the Worship left after paying.
													text_single = {
														name = "pantheon_temple_next_cost_line"
														visible = "[GetScriptedGui('pantheon_ui_temple_upgrade').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
														size = { 206 32 }
														autoresize = no
														align = left|vcenter
														text = "pantheon_ui_temple_next_cost"
														tooltip = "pantheon_ui_temple_next_tt"
													}
													expand = {}
												}
												# The bar reads pantheon_temple_build_months against the build's total (pantheon_ui_temple_build_progress,
												# 0-100); the months only count down while the build is not paused, so a paused bar stands still.
												hbox = {
													name = "pantheon_temple_build_row"
													visible = "[GetPlayer.MakeScope.Var('pantheon_temple_building').IsSet]"
													size = { 476 32 }
													spacing = 10
													widget = {
														size = { 300 32 }
														progressbar_standard = {
															parentanchor = vcenter
															size = { 300 12 }
															min = 0
															max = 100
															value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('pantheon_ui_temple_build_progress') )]"
															blockoverride "progress_textures" {
																progresstexture = "gfx/interface/progressbars/progress_brown.dds"
																noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
															}
														}
													}
													text_single = {
														visible = "[GetPlayer.MakeScope.Var('pantheon_temple_build_months').IsSet]"
														size = { 166 32 }
														autoresize = no
														align = left|vcenter
														text = "pantheon_ui_temple_build_left"
													}
													expand = {}
												}
												text_single = {
													name = "pantheon_temple_complete_line"
													visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ), Not( GetPlayer.MakeScope.Var('pantheon_temple_building').IsSet ) )]"
													size = { 476 32 }
													autoresize = no
													align = left|vcenter
													text = "pantheon_ui_temple_complete"
												}
											}
											# the spare height goes below the rows, so the shown ones sit under the title whichever are hidden
											expand = {}
										}
									}
								}
								# ---- end 2.12 Task 1 header

					# Before founding: the faith's holy sites (One Trait 2.7's proven list form,
					# OneTraitToRuleThemAll/gui/one_trait_panel.gui, datamodel/AddScope('landed_title', Title.MakeScope)).
					# 2.12 Task 2: a 706-wide card under the header (8 + the 690 rows + 8), in place of the miracles and the
					# Sign until a temple is founded. The list is a plain datamodel vbox that grows inside the page scrollbox
					# (no scrollbox in a scrollbox); every text has a fixed size and autoresize = no, the clipping ones their
					# full text as the tooltip. The intro is three lines: 209 characters x 7.5 px over 690-px lines, 20 each.
					vbox = {
						name = "pantheon_temple_found_card"
						visible = "[Not( GetPlayer.MakeScope.Var('pantheon_temple_province').IsSet )]"
						minimumsize = { 706 0 }
						background = { using = Background_Area }
						margin = { 8 6 }
						spacing = 6
						text_single = {
							size = { 690 22 }
							autoresize = no
							align = left|nobaseline
							using = Font_Size_Medium
							text = "pantheon_ui_temple_found_title"
							tooltip = "pantheon_ui_temple_found_title"
						}
						text_single = {
							size = { 690 60 }
							multiline = yes
							autoresize = no
							align = left|top
							text = "pantheon_ui_temple_intro"
							tooltip = "pantheon_ui_temple_intro"
						}
						text_single = {
							visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList('pantheon_ui_temple_sites') )]"
							size = { 690 20 }
							autoresize = no
							align = left|nobaseline
							text = "pantheon_ui_temple_no_sites"
						}
						vbox = {
							datamodel = "[GetPlayer.MakeScope.GetList('pantheon_ui_temple_sites')]"
							spacing = 4
							item = {
								# 10 + 150 name + 10 + 150 holder + 10 + 190 cost + 10 + 150 Found + 10 = 690
								widget = {
									name = "pantheon_temple_found_row"
									size = { 690 50 }
									datacontext = "[Scope.GetLandedTitle]"
									background = { using = Background_Area }
									hbox = {
										margin_left = 10
										margin_right = 10
										spacing = 10
										text_single = {
											name = "pantheon_temple_found_name"
											size = { 150 32 }
											autoresize = no
											align = left|vcenter
											text = "[Title.GetName]"
											tooltip = "[Title.GetName]"
										}
										# the holder's datacontext on this ancestor, not on the leaf text (batch u1 row 34)
										widget = {
											name = "pantheon_temple_found_holder"
											size = { 150 32 }
											datacontext = "[Title.GetHolder]"
											text_single = {
												size = { 150 32 }
												autoresize = no
												align = left|vcenter
												text = "[Character.GetShortUINameNoTooltip]"
												tooltip = "[Character.GetShortUINameNoTooltip]"
											}
										}
										# Batch 2r1 (repair 5): each row gave no idea what founding there would cost.
										# Batch u1 repair (row 4): no size at all here rendered as a lone truncated "..."
										# -- a fixed width gives the text room (One Trait 2.7's lesson again).
										# 2.12 Task 2: its tooltip reads the Worship, so its own IsSet (set from ascension on) guards it.
										text_single = {
											visible = "[GetPlayer.MakeScope.Var('pantheon_worship').IsSet]"
											size = { 190 32 }
											autoresize = no
											align = left|vcenter
											text = "pantheon_ui_temple_found_cost"
											tooltip = "pantheon_temple_found_after_tt"
										}
										button_standard = {
											size = { 150 32 }
											text = "pantheon_ui_btn_temple_found"
											enabled = "[GetScriptedGui('pantheon_ui_temple_found').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'landed_title', Title.MakeScope ).End )]"
											tooltip = "[Select_CString( GetScriptedGui('pantheon_ui_temple_found').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'landed_title', Title.MakeScope ).End ), Localize( 'pantheon_temple_found_after_tt' ), GetScriptedGui('pantheon_ui_temple_found').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'landed_title', Title.MakeScope ).End ) )]"
											onclick = "[GetScriptedGui('pantheon_ui_temple_found').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'landed_title', Title.MakeScope ).End )]"
										}
									}
								}
							}
						}
						# the spare height goes below the rows
						expand = {}
					}

					# After founding: the Miracles card and the Sign (2.12 Task 1: the header, the upgrade and the ladder moved
					# into the header band above; Task 3: the Miracles card replaced the tier-5 buttons and the Wrath note; Task 4: the
					# Sign became a card after it).
					vbox = {
						visible = "[GetPlayer.MakeScope.Var('pantheon_temple_province').IsSet]"
						layoutpolicy_horizontal = expanding
						# 2.12 Task 4: no longer stretches (it did for the Sign's old growing scrollbox); the cards take their own height
						spacing = 8
						datacontext = "[GetPlayer]"

						# ---- 2.12 Task 3: the Miracles card (the "use the temple" half), at every tier once a temple exists. All five
						# miracles need an active tier-5 temple and share one rest (pantheon_miracle_ready_trigger), so the card says why they
						# are greyed: the corner gives the status (needs the tier, dormant, resting, ready, in that order), each card's icon
						# is shaded, and its tooltip gives the effect plus the reason in the corner's order. The tooltips are plain-text keys
						# chosen by Select_CString, never an action's IsValidTooltip (pantheon_miracle_cooldown_tt reads the cooldown, unset
						# below tier 5 or while dormant: "0 months left"). Heights: the 30 title row + 8 + the 112 cards + 8 + the 56 cards
						# = 214. Widths: 3 x 230 + 2 x 8 = 706 and 2 x 349 + 8 = 706. The cards' children let the mouse through, so the
						# card's tooltip shows over them; the Invoke button keeps its own.
						vbox = {
							name = "pantheon_temple_miracles"
							spacing = 8
							widget = {
								name = "pantheon_temple_miracles_title_row"
								size = { 706 30 }
								background = { using = Background_Area }
								text_single = {
									position = { 10 0 }
									size = { 400 30 }
									autoresize = no
									align = left|vcenter
									using = Font_Size_Medium
									text = "pantheon_ui_miracles_title"
								}
								# the status, exactly one of four; the months only under their own IsSet
								widget = {
									name = "pantheon_temple_miracles_corner"
									position = { 420 0 }
									size = { 276 30 }
									text_single = {
										visible = "[Not( And( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ) ) )]"
										size = { 276 30 }
										autoresize = no
										align = right|vcenter
										text = "pantheon_ui_miracles_needs_tier"
									}
									text_single = {
										visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ), Not( GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
										size = { 276 30 }
										autoresize = no
										align = right|vcenter
										text = "pantheon_ui_miracles_dormant"
									}
									# resting: one of three texts by the months left (2.12 text polish): under 24 "Rests N months"
									# (exactly 1: "Rests 1 month"), from 24 "Rests N years" rounded up (pantheon_ui_miracle_rest_years)
									text_single = {
										visible = "[And( And4( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ), GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetPlayer.MakeScope.Var('pantheon_temple_cooldown_months').IsSet ), And( Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_cooldown_months').GetValue, '(CFixedPoint)1' ) ), Not( GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_cooldown_months').GetValue, '(CFixedPoint)24' ) ) ) )]"
										size = { 276 30 }
										autoresize = no
										align = right|vcenter
										text = "pantheon_ui_miracles_resting"
										tooltip = "pantheon_ui_miracles_resting"
									}
									text_single = {
										visible = "[And( And4( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ), GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetPlayer.MakeScope.Var('pantheon_temple_cooldown_months').IsSet ), EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_cooldown_months').GetValue, '(CFixedPoint)1' ) )]"
										size = { 276 30 }
										autoresize = no
										align = right|vcenter
										text = "pantheon_ui_miracles_resting_1"
										tooltip = "pantheon_ui_miracles_resting_1"
									}
									text_single = {
										visible = "[And( And4( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ), GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetPlayer.MakeScope.Var('pantheon_temple_cooldown_months').IsSet ), GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_cooldown_months').GetValue, '(CFixedPoint)24' ) )]"
										size = { 276 30 }
										autoresize = no
										align = right|vcenter
										text = "pantheon_ui_miracles_resting_years"
										tooltip = "pantheon_ui_miracles_resting_years"
									}
									text_single = {
										visible = "[GetScriptedGui('pantheon_ui_miracle_conversion').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										size = { 276 30 }
										autoresize = no
										align = right|vcenter
										text = "pantheon_ui_miracles_ready"
									}
								}
							}
							# Mass Conversion, Age of Faith, Divine Victory: icon, name, effect, and the Invoke button or the reason
							hbox = {
								spacing = 8
								widget = {
									name = "pantheon_card_miracle_conversion"
									size = { 230 112 }
									background = { using = Background_Area }
									tooltip = "[Select_CString( Not( And( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ) ) ), Localize( 'pantheon_ui_miracle_conversion_card_needs_tt' ), Select_CString( And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ), Not( GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Localize( 'pantheon_ui_miracle_conversion_card_dormant_tt' ), Select_CString( And4( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ), GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetPlayer.MakeScope.Var('pantheon_temple_cooldown_months').IsSet ), Localize( 'pantheon_ui_miracle_conversion_card_resting_tt' ), Localize( 'pantheon_ui_miracle_conversion_card_tt' ) ) ) )]"
									widget = {
										position = { 8 8 }
										size = { 48 48 }
										alwaystransparent = yes
										icon = {
											size = { 48 48 }
											alwaystransparent = yes
											texture = "gfx/interface/icons/pantheon/pantheon_miracle_conversion.dds"
										}
										# greyed while the miracles are not ready (all five share pantheon_miracle_ready_trigger)
										icon = {
											visible = "[Not( GetScriptedGui('pantheon_ui_miracle_conversion').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
											size = { 48 48 }
											alwaystransparent = yes
											texture = "gfx/interface/icons/pantheon/pantheon_card_shade.dds"
										}
									}
									text_single = {
										position = { 60 8 }
										size = { 162 22 }
										using = Font_Size_Medium
										autoresize = no
										align = left|nobaseline
										alwaystransparent = yes
										text = "pantheon_ui_btn_miracle_conversion"
									}
									text_single = {
										position = { 60 30 }
										size = { 162 40 }
										multiline = yes
										autoresize = no
										align = left|top
										alwaystransparent = yes
										text = "pantheon_ui_miracle_conversion_line"
									}
									# the Invoke button, verbatim but for its position and visible: only at an active tier 5, where its tooltip's
									# reason (pantheon_miracle_cooldown_tt) reads a cooldown that is set or reads nothing
									button_standard = {
										visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ), GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
										position = { 10 74 }
										size = { 210 32 }
										enabled = "[GetScriptedGui('pantheon_ui_miracle_conversion').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										# Batch u1 repair (row 21): the tooltip only ever showed the not-ready/confirm reason
										# (and nothing at all while ready) -- now always shows what the miracle does, the reason
										# (if any) on its own line below.
										tooltip = "pantheon_ui_miracle_conversion_tt"
										onclick = "[GetScriptedGui('pantheon_ui_miracle_conversion').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										# One Trait's confirm-label swap (gui/one_trait_panel.gui:1421-1443): two mutually
										# exclusive labels in a fixed-size widget, toggled by the armed scripted GUI.
										widget = {
											size = { 210 32 }
											text_single = {
												visible = "[Not( GetScriptedGui('pantheon_ui_miracle_conversion_armed').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
												size = { 210 32 }
												autoresize = no
												align = center|vcenter
												text = "pantheon_ui_btn_miracle_invoke"
											}
											text_single = {
												visible = "[GetScriptedGui('pantheon_ui_miracle_conversion_armed').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
												size = { 210 32 }
												autoresize = no
												align = center|vcenter
												text = "pantheon_ui_btn_confirm"
											}
										}
									}
									# in the button's place below tier 5 or while dormant: the reason, the corner's own conditions
									text_single = {
										visible = "[Not( And( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ) ) )]"
										position = { 10 75 }
										size = { 210 30 }
										autoresize = no
										align = center|vcenter
										alwaystransparent = yes
										text = "pantheon_ui_miracles_needs_tier"
									}
									text_single = {
										visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ), Not( GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
										position = { 10 75 }
										size = { 210 30 }
										autoresize = no
										align = center|vcenter
										alwaystransparent = yes
										text = "pantheon_ui_miracles_dormant"
									}
								}
								widget = {
									name = "pantheon_card_miracle_age"
									size = { 230 112 }
