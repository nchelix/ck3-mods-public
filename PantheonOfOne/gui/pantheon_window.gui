												position = { 0 4 }
												size = { 300 12 }
												min = 0
												max = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('pantheon_ui_age_full') )]"
												value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('pantheon_ui_age_left') )]"
												blockoverride "progress_textures" {
													progresstexture = "gfx/interface/progressbars/progress_standard.dds"
													noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
												}
											}
											progressbar_standard = {
												visible = "[Not( GetPlayer.MakeScope.Var('pantheon_temple_age_months').IsSet )]"
												position = { 0 4 }
												size = { 300 12 }
												min = 0
												max = 1
												value = 0
												blockoverride "progress_textures" {
													progresstexture = "gfx/interface/progressbars/progress_standard.dds"
													noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
												}
											}
										}
										widget = {
											size = { 162 20 }
											text_single = {
												visible = "[And( GetPlayer.MakeScope.Var('pantheon_temple_age_months').IsSet, NotEqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_age_months').GetValue, '(CFixedPoint)1' ) )]"
												size = { 162 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_ready_age_left"
											}
											# P2e: "1 month left", not "1 months left" (the value read only after the IsSet in the same And)
											text_single = {
												visible = "[And( GetPlayer.MakeScope.Var('pantheon_temple_age_months').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_age_months').GetValue, '(CFixedPoint)1' ) )]"
												size = { 162 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_ready_one_month_left"
											}
											text_single = {
												visible = "[Not( GetPlayer.MakeScope.Var('pantheon_temple_age_months').IsSet )]"
												size = { 162 20 }
												autoresize = no
