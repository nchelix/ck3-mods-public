				# ---- Tab 4: The Temple (2.2 Task 4)
				vbox = {
					visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_tab').GetValue, '(CFixedPoint)4' )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 8

					# Before founding: the faith's holy sites, a scroll list (One Trait 2.7's proven list form,
					# OneTraitToRuleThemAll/gui/one_trait_panel.gui, datamodel/AddScope('landed_title', Title.MakeScope)).
					vbox = {
						visible = "[Not( GetPlayer.MakeScope.Var('pantheon_temple_province').IsSet )]"
						layoutpolicy_horizontal = expanding
