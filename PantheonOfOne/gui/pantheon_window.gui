												text = "pantheon_ui_ready_not_active"
											}
										}
									}
									expand = {}
								}
							}

							# ---- Your pantheon (P2e, user decision 2026-11-09: the footer becomes a card, as the others). Full width as Ready
							# when, its title in the cards' style, then a grid of 3 columns x 2 rows of fixed cells (300 + 8 + 186 + 8 + 184 = 686,
							# the card's inner width), so the columns line up down the rows: the temple, Demigods, Godsblood houses; Prayers heard,
							# Boons asked, an empty cell. P2f (Codex P2e repair review): the first column is the widest, for the longest temple
							# text, "Temple: Great Temple (building paused)" (270 px in vanilla's 15 px Gitan); the temple texts also name the
							# temple in a tooltip, for a translation that still overflows. Every cell is one "Label: N" text (the two list
							# sizes are built in their loc, as vanilla builds counts in loc with GetDataModelSize). The temple name is a Custom loc on the god, so the datacontext sits here on
							# an ancestor (a leaf text_single's own datacontext is not used for its text). Height: 6 + 22 + 3 + 20 + 3 + 20 + 6 = 80.
							widget = {
								name = "pantheon_god_footer"
								datacontext = "[GetPlayer]"
								size = { 706 80 }
								background = { using = Background_Area }
								vbox = {
									margin = { 10 6 }
									spacing = 3
									text_single = {
										size = { 686 22 }
										autoresize = no
										align = left|nobaseline
										using = Font_Size_Medium
										text = "pantheon_ui_card_pantheon_t"
									}
									hbox = {
										spacing = 8
										widget = {
											size = { 300 20 }
											text_single = {
												visible = "[Or( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, GetPlayer.MakeScope.Var('pantheon_temple_build_tier').IsSet )]"
												size = { 300 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_footer_temple"
												tooltip = "pantheon_ui_footer_temple"
											}
											text_single = {
												visible = "[Not( Or( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, GetPlayer.MakeScope.Var('pantheon_temple_build_tier').IsSet ) )]"
												size = { 300 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_footer_no_temple"
												tooltip = "pantheon_ui_footer_no_temple"
											}
										}
										widget = {
											size = { 186 20 }
											text_single = {
												size = { 186 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_footer_demigods"
											}
										}
										widget = {
											size = { 184 20 }
											text_single = {
												size = { 184 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_footer_houses"
											}
										}
									}
									# P2d (Codex Phase 2 review): both counters are set lazily (the first prayer heard, the first boon asked), so each
									# count is a pair of texts in one fixed cell, as the temple / no-temple pair above: the value only while set, a
									# literal 0 before (Phase 1 batch F's debug counter, pantheon_dbg_gp_s_nocounter).
									hbox = {
										spacing = 8
										widget = {
											size = { 300 20 }
											text_single = {
												visible = "[GetPlayer.MakeScope.Var('pantheon_prayer_seq').IsSet]"
												size = { 300 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_footer_prayers"
											}
											text_single = {
												visible = "[Not( GetPlayer.MakeScope.Var('pantheon_prayer_seq').IsSet )]"
												size = { 300 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_footer_no_prayers"
											}
										}
										widget = {
											size = { 186 20 }
											text_single = {
												visible = "[GetPlayer.MakeScope.Var('pantheon_boon_request_seq').IsSet]"
												size = { 186 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_footer_boons"
											}
											text_single = {
												visible = "[Not( GetPlayer.MakeScope.Var('pantheon_boon_request_seq').IsSet )]"
												size = { 186 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_footer_no_boons"
											}
										}
										widget = {
											size = { 184 20 }
										}
									}
									expand = {}
								}
							}
						}
								}
							}
						}
					}

					# ---- Sub-tab 2: Seeded lands, moved here unchanged (P2d: every variable read now behind its IsSet; the seed
					# effect sets pantheon_seed_lean and pantheon_seed_end on every seeded county, so nothing shown changes)
					vbox = {
						visible = "[And( GetPlayer.MakeScope.Var('pantheon_ui_gtab').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_gtab').GetValue, '(CFixedPoint)2' ) )]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 8

						# 2.8 (#59): Seeded lands. The god's own list of seeded counties (pantheon_seeded_counties), read straight
						# from the variable list (the Temple tab's list form). Every column has a fixed width, so a long county
						# or holder name is cut at its cell instead of pushing the row wider.
						text_single = { text = "pantheon_ui_seeds_header" using = Font_Size_Medium }
						text_single = {
							visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList('pantheon_ui_seeds') )]"
							text = "pantheon_ui_seeds_empty"
						}
						scrollbox = {
							# 2.8 repair 4: 7 rows (7 x 36 + 6 x 4 = 276) with margin. 9 rows (370) could overflow the 900 window when the
							# selected-follower strip above every tab is tall and every God-tab status line shows (Codex repair review 5).
							size = { 680 290 }
							blockoverride "scrollbox_content" {
								vbox = {
									layoutpolicy_horizontal = expanding
									datamodel = "[GetPlayer.MakeScope.GetList('pantheon_ui_seeds')]"
									spacing = 4
									item = {
										widget = {
											size = { 660 36 }
											datacontext = "[Scope.GetLandedTitle]"
											background = { using = Background_Area }
											hbox = {
												margin_left = 10
												margin_right = 10
												spacing = 8
												text_single = {
													size = { 150 32 }
													autoresize = no
													align = left|vcenter
													text = "[Title.GetName]"
												}
												text_single = {
													size = { 170 32 }
													autoresize = no
													align = left|vcenter
													datacontext = "[Title.GetHolder]"
													text = "[Character.GetShortUINameNoTooltip]"
												}
												text_single = {
													visible = "[And( Title.MakeScope.Var('pantheon_seed_lean').IsSet, EqualTo_CFixedPoint( Title.MakeScope.Var('pantheon_seed_lean').GetValue, '(CFixedPoint)1' ) )]"
													size = { 90 32 }
													autoresize = no
													align = left|vcenter
													text = "pantheon_ui_seed_lean_1"
												}
												text_single = {
													visible = "[And( Title.MakeScope.Var('pantheon_seed_lean').IsSet, EqualTo_CFixedPoint( Title.MakeScope.Var('pantheon_seed_lean').GetValue, '(CFixedPoint)2' ) )]"
													size = { 90 32 }
													autoresize = no
													align = left|vcenter
													text = "pantheon_ui_seed_lean_2"
												}
												text_single = {
													visible = "[And( Title.MakeScope.Var('pantheon_seed_lean').IsSet, EqualTo_CFixedPoint( Title.MakeScope.Var('pantheon_seed_lean').GetValue, '(CFixedPoint)0' ) )]"
													size = { 90 32 }
													autoresize = no
													align = left|vcenter
													text = "pantheon_ui_seed_lean_0"
												}
												text_single = {
													visible = "[Title.MakeScope.Var('pantheon_meter').IsSet]"
													size = { 90 32 }
													autoresize = no
													align = left|vcenter
													text = "pantheon_ui_seed_meter"
												}
												text_single = {
													visible = "[Not( Title.MakeScope.Var('pantheon_meter').IsSet )]"
													size = { 90 32 }
													autoresize = no
													align = left|vcenter
													text = "pantheon_ui_seed_own"
												}
												text_single = {
													visible = "[Title.MakeScope.Var('pantheon_seed_end').IsSet]"
													size = { 80 32 }
													autoresize = no
													align = left|vcenter
													text = "pantheon_ui_seed_until"
												}
											}
										}
									}
								}
							}
						}
						# P2d: the tab's trailing expand moved here, so it no longer shares the Overview's height with it
						expand = {}
					}
				}

				# ---- Tab 4: The Temple (2.2 Task 4)
				vbox = {
					visible = "[And( GetPlayer.MakeScope.Var('pantheon_ui_tab').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_ui_tab').GetValue, '(CFixedPoint)4' ) )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 8

					# 2.12 Task 1: the whole tab is one page that scrolls in the height the window leaves it, the God page Overview's
					# form (its P2d comment): the box expands, draws no background of its own (the cards draw theirs) and keeps 16 on
					# the right for vanilla's scrollbar, so the 706 the cards take fits the 722 column exactly. With no sub-tab row
					# the page has about 725 high with no follower strip selected and about 415 under the 348-high strip, where it
					# scrolls. The content below the header keeps its old indentation, so the diff stays small.
					scrollbox = {
						name = "pantheon_temple_scroll"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_background" {}
						blockoverride "scrollbox_margins" {
							margin_right = 16
						}
						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 8

								# ---- 2.12 Task 1: the header band, shown with or without a temple. A fixed 706 x 195 card: 10 + the
								# 200 x 175 picture + 10 + a 476-wide column + 10 = 706; the column's rows are 26 + 20 + 20 + 20 + 46 + 32
								# = 164, plus five gaps of 2 = 174 of its 175. Every text has a fixed size and autoresize = no, so a long
								# name or translation clips at its width instead of pushing the card; the ones that may clip carry their
								# full text as the tooltip. The datacontext sits on this ancestor, not on a leaf (a leaf's own
								# datacontext was not honoured for its own text, batch u1 row 34).
								widget = {
									name = "pantheon_temple_header"
									size = { 706 195 }
									background = { using = Background_Area }
									datacontext = "[GetPlayer]"

									hbox = {
										margin = { 10 10 }
										spacing = 10

										# The current tier's picture. Dimmed (the _dim copy) whenever the temple is not working:
										# dormant, a paused build, and the first Shrine still building -- pantheon_ui_temple_view_active
										# is pantheon_temple_active_trigger, false in all three. With the tier unset (no temple, or the
										# first Shrine building) it is the tier-1 picture, dimmed. Hovering gives the tier's bonuses.
										# The icons let the mouse through, so the widget's own tooltip shows.
										widget = {
											name = "pantheon_temple_picture"
											size = { 200 175 }
											tooltip = "[Character.Custom('pantheon_temple_tier_desc')]"
											icon = {
												visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)1' ), GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
												size = { 200 175 }
												alwaystransparent = yes
												texture = "gfx/interface/icons/pantheon/pantheon_temple_page_01.dds"
											}
											icon = {
												visible = "[Or( Not( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet ), And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)1' ), Not( GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) )]"
												size = { 200 175 }
												alwaystransparent = yes
												texture = "gfx/interface/icons/pantheon/pantheon_temple_page_01_dim.dds"
											}
											icon = {
												visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)2' ), GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
												size = { 200 175 }
												alwaystransparent = yes
												texture = "gfx/interface/icons/pantheon/pantheon_temple_page_02.dds"
											}
											icon = {
												visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)2' ), Not( GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
												size = { 200 175 }
												alwaystransparent = yes
												texture = "gfx/interface/icons/pantheon/pantheon_temple_page_02_dim.dds"
											}
											icon = {
												visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)3' ), GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
												size = { 200 175 }
												alwaystransparent = yes
												texture = "gfx/interface/icons/pantheon/pantheon_temple_page_03.dds"
											}
											icon = {
												visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)3' ), Not( GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
												size = { 200 175 }
												alwaystransparent = yes
												texture = "gfx/interface/icons/pantheon/pantheon_temple_page_03_dim.dds"
											}
											icon = {
												visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)4' ), GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
												size = { 200 175 }
												alwaystransparent = yes
												texture = "gfx/interface/icons/pantheon/pantheon_temple_page_04.dds"
											}
											icon = {
												visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)4' ), Not( GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
												size = { 200 175 }
												alwaystransparent = yes
												texture = "gfx/interface/icons/pantheon/pantheon_temple_page_04_dim.dds"
											}
											icon = {
												visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ), GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
												size = { 200 175 }
												alwaystransparent = yes
												texture = "gfx/interface/icons/pantheon/pantheon_temple_page_05.dds"
											}
											icon = {
												visible = "[And3( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)5' ), Not( GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
												size = { 200 175 }
												alwaystransparent = yes
												texture = "gfx/interface/icons/pantheon/pantheon_temple_page_05_dim.dds"
											}
										}

										vbox = {
											name = "pantheon_temple_header_column"
											size = { 476 175 }
											spacing = 2
											ignoreinvisible = yes

											# "High Temple · Active": the tier name and the short state. 2.12 Task 2: with no temple
											# (pantheon_temple_province unset) "No temple yet" in its place, in the same 476 x 26 row.
											widget = {
												name = "pantheon_temple_title_row"
												size = { 476 26 }
												text_single = {
													name = "pantheon_temple_title"
													visible = "[GetPlayer.MakeScope.Var('pantheon_temple_province').IsSet]"
													size = { 476 26 }
													autoresize = no
													align = left|nobaseline
													using = Font_Size_Medium
													text = "pantheon_ui_temple_title"
													tooltip = "pantheon_ui_temple_title"
												}
												text_single = {
													name = "pantheon_temple_title_none"
													visible = "[Not( GetPlayer.MakeScope.Var('pantheon_temple_province').IsSet )]"
													size = { 476 26 }
													autoresize = no
													align = left|nobaseline
													using = Font_Size_Medium
													text = "pantheon_ui_temple_title_none"
													tooltip = "pantheon_ui_temple_title_none"
												}
											}
											# Batch 2r1 (repair 5): which county holds the temple
											text_single = {
												name = "pantheon_temple_county_line"
												visible = "[GetPlayer.MakeScope.Var('pantheon_temple_province').IsSet]"
												size = { 476 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_temple_county"
												tooltip = "pantheon_ui_temple_county"
											}
											# The long state (no temple, building with the months left, paused and why, dormant and why),
											# hidden while the temple simply works (active, nothing building)
											text_single = {
												name = "pantheon_temple_state_line"
												visible = "[Or( Not( GetScriptedGui('pantheon_ui_temple_view_active').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), GetPlayer.MakeScope.Var('pantheon_temple_building').IsSet )]"
												size = { 476 20 }
												autoresize = no
												align = left|nobaseline
												text = "[Character.Custom('pantheon_temple_state')]"
												tooltip = "[Character.Custom('pantheon_temple_state')]"
											}
											# R13, batch 2b: the capital could not be made a holy site (e.g. the faith was already at its
											# holy-site maximum). The temple itself still works fully.
											text_single = {
												name = "pantheon_temple_refused_line"
												visible = "[GetPlayer.MakeScope.Var('pantheon_temple_holy_site_refused').IsSet]"
												size = { 476 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_temple_holy_site_refused"
											}

											# The tier track: five round markers joined by a line, the short tier name under each. Plain
											# icons, no button frame (batch u2: the old button_tab cells looked clickable and did nothing).
											# Each 92-wide cell (5 x 92 + 4 x 4 = 476) has the empty marker, the filled one up to the current
											# tier, or the dashed one for the tier being built, exactly one at a time; its tooltip gives that
											# tier's bonuses, cost and years (pantheon_temple_ladder_tt_N). The line runs in four 72-wide pieces
											# between the markers (cell centres 96 apart, 24-wide markers), so it never shows through a ring.
											widget = {
												name = "pantheon_temple_track"
												size = { 476 46 }
												icon = {
													position = { 58 10 }
													size = { 72 4 }
													alwaystransparent = yes
													texture = "gfx/interface/icons/pantheon/pantheon_temple_track_line.dds"
												}
												icon = {
													position = { 154 10 }
													size = { 72 4 }
													alwaystransparent = yes
													texture = "gfx/interface/icons/pantheon/pantheon_temple_track_line.dds"
												}
												icon = {
													position = { 250 10 }
													size = { 72 4 }
													alwaystransparent = yes
													texture = "gfx/interface/icons/pantheon/pantheon_temple_track_line.dds"
												}
												icon = {
													position = { 346 10 }
													size = { 72 4 }
													alwaystransparent = yes
													texture = "gfx/interface/icons/pantheon/pantheon_temple_track_line.dds"
												}
												hbox = {
													spacing = 4
													widget = {
														name = "pantheon_temple_marker_1"
														size = { 92 46 }
														tooltip = "pantheon_temple_ladder_tt_1"
														icon = {
															visible = "[And( Not( And( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)1' ) ) ), Not( And( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').GetValue, '(CFixedPoint)1' ) ) ) )]"
															position = { 34 0 }
															size = { 24 24 }
															alwaystransparent = yes
															texture = "gfx/interface/icons/pantheon/pantheon_temple_marker_empty.dds"
														}
														icon = {
															visible = "[And( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)1' ) )]"
															position = { 34 0 }
															size = { 24 24 }
															alwaystransparent = yes
															texture = "gfx/interface/icons/pantheon/pantheon_temple_marker_filled.dds"
														}
														icon = {
															visible = "[And( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').GetValue, '(CFixedPoint)1' ) )]"
															position = { 34 0 }
															size = { 24 24 }
															alwaystransparent = yes
															texture = "gfx/interface/icons/pantheon/pantheon_temple_marker_dashed.dds"
														}
														text_single = {
															position = { 0 28 }
															size = { 92 18 }
															autoresize = no
															align = center|nobaseline
															using = Font_Size_Small
															alwaystransparent = yes
															text = "building_type_pantheon_great_temple_01"
														}
													}
													widget = {
														name = "pantheon_temple_marker_2"
														size = { 92 46 }
														tooltip = "pantheon_temple_ladder_tt_2"
														icon = {
															visible = "[And( Not( And( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)2' ) ) ), Not( And( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').GetValue, '(CFixedPoint)2' ) ) ) )]"
															position = { 34 0 }
															size = { 24 24 }
															alwaystransparent = yes
															texture = "gfx/interface/icons/pantheon/pantheon_temple_marker_empty.dds"
														}
														icon = {
															visible = "[And( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)2' ) )]"
															position = { 34 0 }
															size = { 24 24 }
															alwaystransparent = yes
															texture = "gfx/interface/icons/pantheon/pantheon_temple_marker_filled.dds"
														}
														icon = {
															visible = "[And( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').GetValue, '(CFixedPoint)2' ) )]"
															position = { 34 0 }
															size = { 24 24 }
															alwaystransparent = yes
															texture = "gfx/interface/icons/pantheon/pantheon_temple_marker_dashed.dds"
														}
														text_single = {
															position = { 0 28 }
															size = { 92 18 }
															autoresize = no
															align = center|nobaseline
															using = Font_Size_Small
															alwaystransparent = yes
															text = "building_type_pantheon_great_temple_02"
														}
													}
													widget = {
														name = "pantheon_temple_marker_3"
														size = { 92 46 }
														tooltip = "pantheon_temple_ladder_tt_3"
														icon = {
															visible = "[And( Not( And( GetPlayer.MakeScope.Var('pantheon_temple_tier').IsSet, GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_tier').GetValue, '(CFixedPoint)3' ) ) ), Not( And( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').IsSet, EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_build_tier').GetValue, '(CFixedPoint)3' ) ) ) )]"
															position = { 34 0 }
