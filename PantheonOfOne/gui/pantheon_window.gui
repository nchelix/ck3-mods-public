												size = { 162 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_ready_steady_left"
											}
											text_single = {
												visible = "[And( GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_temple_active_tier'), '(CFixedPoint)1' ), Not( GetPlayer.MakeScope.Var('pantheon_steady_cooldown').IsSet ) )]"
												size = { 162 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_ready_now"
											}
										}
									}

									# Plague's toll: pantheon_plague_sent, years = 3 (1095 days) at both setters. P2d (user decision
									# 2026-11-08): it stops no plague being sent; it is the window in which the quarterly pulse takes
									# 5 Devotion, once, from followers near an outbreak (pantheon_wrath_effects.txt). So the row is
									# never "Ready": the bar and the time left while it runs, an empty track and a neutral "None" when not.
									hbox = {
										name = "pantheon_ready_plague"
										spacing = 8
										text_single = {
											size = { 200 20 }
											autoresize = no
											align = left|nobaseline
											text = "pantheon_ui_ready_plague_toll"
											tooltip = "pantheon_ui_ready_plague_toll_tt"
										}
										widget = {
											size = { 300 20 }
											progressbar_standard = {
												visible = "[GetPlayer.MakeScope.Var('pantheon_plague_sent').IsSet]"
												position = { 0 4 }
												size = { 300 12 }
												min = 0
												max = 1095
												value = "[IntToFloat( Subtract_int32( '(int32)1095', GetPlayer.MakeScope.VarRemaining('pantheon_plague_sent') ) )]"
												blockoverride "progress_textures" {
													progresstexture = "gfx/interface/progressbars/progress_standard.dds"
													noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
												}
											}
											progressbar_standard = {
												visible = "[Not( GetPlayer.MakeScope.Var('pantheon_plague_sent').IsSet )]"
												position = { 0 4 }
												size = { 300 12 }
												min = 0
												max = 1
												value = 0
												blockoverride "progress_textures" {
													progresstexture = "gfx/interface/progressbars/progress_standard.dds"
													noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
												}
											}
										}
										widget = {
											size = { 162 20 }
											text_single = {
												visible = "[GetPlayer.MakeScope.Var('pantheon_plague_sent').IsSet]"
												size = { 162 20 }
												autoresize = no
												align = left|nobaseline
