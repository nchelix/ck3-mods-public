												visible = "[LessThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_temple_active_tier'), '(CFixedPoint)1' )]"
												size = { 162 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_ready_needs_temple"
											}
											text_single = {
												visible = "[And( GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_temple_active_tier'), '(CFixedPoint)1' ), LessThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_temple_active_tier'), '(CFixedPoint)5' ) )]"
												size = { 162 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_ready_needs_tier"
											}
											text_single = {
												visible = "[And3( GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('pantheon_temple_active_tier'), '(CFixedPoint)5' ), GetPlayer.MakeScope.Var('pantheon_temple_cooldown_months').IsSet, NotEqualTo_CFixedPoint( GetPlayer.MakeScope.Var('pantheon_temple_cooldown_months').GetValue, '(CFixedPoint)1' ) )]"
												size = { 162 20 }
												autoresize = no
												align = left|nobaseline
												text = "pantheon_ui_ready_miracle_left"
											}
